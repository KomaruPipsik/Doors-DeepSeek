--// Utility Functions
local function SafeFind(instance, ...)
	local success, result = pcall(function()
		return instance:FindFirstChild(...)
	end)
	return success and result or nil
end

local function DisplayNotification(message, duration)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "Hobbit System",
			Text = message,
			Duration = duration or 3,
		})
	end)
end

--// ESP Functions
local function CreateESP(part, color)
	if not part or not part:IsA("BasePart") then return nil end

	local success, highlight = pcall(function()
		local h = Instance.new("Highlight")
		h.FillColor = color
		h.FillTransparency = 0.5
		h.OutlineColor = color
		h.OutlineTransparency = 0
		h.Adornee = part
		h.Parent = part
		return h
	end)
	return success and highlight or nil
end

local function ClearAllESP()
	for _, esp in ipairs(Core.ESPObjects) do
		pcall(function() esp:Destroy() end)
	end
	table.clear(Core.ESPObjects)
end

--// Character Detection
local function GetCharacter()
	Character = LocalPlayer.Character
	if Character then
		Humanoid = SafeFind(Character, "Humanoid")
		RootPart = SafeFind(Character, "HumanoidRootPart")
	end
end

