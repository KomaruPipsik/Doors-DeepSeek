_G.DoorsUtilityCleanup = function()
	for _, conn in ipairs(Connections) do
		conn:Disconnect()
	end
	for _, obj in ipairs(Workspace:GetDescendants()) do
		RemoveHighlight(obj)
	end
	ToggleFullBright(false)
	_G.DoorsUtilityLoaded = nil
	print("DoorsUtility успешно выгружен.")
end

