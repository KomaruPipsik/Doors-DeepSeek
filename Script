	-- Player Mods
	addSection("⚡ PLAYER MODS")
	addToggle("FullBright", Config.FullBright.Enabled, function(v) 
		Config.FullBright.Enabled = v
		toggleFullBright(v)
	end)
	addToggle("FPS Booster", Config.FPSBooster.Enabled, function(v) 
		Config.FPSBooster.Enabled = v
		toggleFPSBoost(v)
	end)
	addToggle("Speed Hack (24)", Config.CustomSpeed.Enabled, function(v) 
		Config.CustomSpeed.Enabled = v
		if Humanoid then
			Humanoid.WalkSpeed = v and Config.CustomSpeed.Speed or 16
		end
	end)

	-- Minimize btn
	local minBtn = Instance.new("TextButton")
	minBtn.Size = UDim2.new(0, 25, 0, 25)
	minBtn.Position = UDim2.new(1, -30, 0, 5)
	minBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
	minBtn.Text = "_"
	minBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	minBtn.Font = Enum.Font.GothamBold
	minBtn.TextSize = 16
	minBtn.BorderSizePixel = 0
	minBtn.Parent = main
	Instance.new("UICorner", minBtn)

	local min = false
	minBtn.MouseButton1Click:Connect(function()
		min = not min
		main.Size = min and UDim2.new(0, 250, 0, 40) or UDim2.new(0, 250, 0, 400)
		minBtn.Text = min and "□" or "_"
	end)
end

--// Main loop
local function periodicScan()
	while true do
		pcall(scanDupeDoors)
		pcall(scanKeys)
		pcall(scanSnares)
		pcall(scanBreakers)
		pcall(scanBooks)
		pcall(checkFigure)
		task.wait(1)
	end
end

--// Init
local function init()
	buildGUI()
	toggleFullBright(Config.FullBright.Enabled)
	
	table.insert(Core.Connections, startRushMonitor())
	table.insert(Core.Connections, startEyesMonitor())
	table.insert(Core.Connections, startScreechMonitor())
	
	if Humanoid then
		table.insert(Core.Connections, Humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
			if Config.CustomSpeed.Enabled and Humanoid.WalkSpeed ~= Config.CustomSpeed.Speed then
				Humanoid.WalkSpeed = Config.CustomSpeed.Speed
			end
		end))
	end
	
	task.spawn(periodicScan)
	print("✅ Hobbit GUI v4.0 Loaded! Menu should be visible on screen")
end

--// Cleanup
LocalPlayer.CharacterRemoving:Connect(function()
	clearESP()
	for _, c in ipairs(Core.Connections) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(Core.Connections)
end)

-- Start everything
init()
