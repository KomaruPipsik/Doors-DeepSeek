--[[
	Doors Hobbit/Escape Client Script with GUI
	Version: 4.0 - FIXED GUI
--]]

--// Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local Workspace = game:GetService("Workspace")
local UserInputService = game:GetService("UserInputService")

--// Local Player
local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
local Camera = Workspace.CurrentCamera
local Character, Humanoid, RootPart

--// Configuration
local Config = {
	ESP = {
		DupeDoor = { Enabled = true, Color = Color3.fromRGB(255, 100, 100) },
		Key = { Enabled = true, Color = Color3.fromRGB(255, 215, 0) },
		Snare = { Enabled = true, Color = Color3.fromRGB(255, 0, 0) },
		Breaker = { Enabled = true, Color = Color3.fromRGB(0, 255, 255) },
		Book = { Enabled = true, Color = Color3.fromRGB(0, 255, 0) },
	},
	Entities = {
		RushAlert = { Enabled = true },
		AmbushAlert = { Enabled = true },
		EyesProtection = { Enabled = true, AutoLookAway = true, LookAwayAngle = 85 },
		ScreechAlert = { Enabled = true, AutoLook = true },
	},
	FigureAvoidance = { Enabled = true, AvoidRadius = 25 },
	CustomSpeed = { Enabled = false, Speed = 24 },
	FullBright = { Enabled = true },
	FPSBooster = { Enabled = false },
}

--// Core
local Core = {
	ESPObjects = {},
	Connections = {},
	ScreechAlerted = {},
}

--// Utility
local function safeFind(instance, ...)
	local s, r = pcall(function() return instance:FindFirstChild(...) end)
	return s and r or nil
end

local function notify(msg, dur)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "Hobbit System",
			Text = msg,
			Duration = dur or 3,
		})
	end)
end

--// ESP
local function createHighlight(part, color)
	if not part or not part:IsA("BasePart") then return nil end
	local s, h = pcall(function()
		local hl = Instance.new("Highlight")
		hl.FillColor = color
		hl.FillTransparency = 0.5
		hl.OutlineColor = color
		hl.OutlineTransparency = 0
		hl.Adornee = part
		hl.Parent = part
		return hl
	end)
	return s and h or nil
end

local function clearESP()
	for _, h in ipairs(Core.ESPObjects) do
		pcall(function() h:Destroy() end)
	end
	table.clear(Core.ESPObjects)
end

--// Character
local function getChar()
	Character = LocalPlayer.Character
	if Character then
		Humanoid = safeFind(Character, "Humanoid")
		RootPart = safeFind(Character, "HumanoidRootPart")
	end
end

LocalPlayer.CharacterAdded:Connect(function()
	task.wait(0.1)
	getChar()
	if Config.CustomSpeed.Enabled and Humanoid then
		Humanoid.WalkSpeed = Config.CustomSpeed.Speed
	end
end)
getChar()

--// Features
local function toggleFullBright(on)
	if on then
		Lighting.Brightness = 0.3
		Lighting.Ambient = Color3.fromRGB(180, 180, 180)
		Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
		Lighting.FogEnd = 10000
		Lighting.FogStart = 0
		pcall(function() Lighting.ClockTime = 14 end)
	else
		Lighting.Brightness = 1
		Lighting.Ambient = Color3.fromRGB(0, 0, 0)
		Lighting.OutdoorAmbient = Color3.fromRGB(70, 70, 70)
	end
end

local function toggleFPSBoost(on)
	if on then
		pcall(function() settings().Rendering.QualityLevel = 1 end)
		for _, d in ipairs(Workspace:GetDescendants()) do
			pcall(function()
				if d:IsA("BasePart") then
					d.Material = Enum.Material.SmoothPlastic
				elseif d:IsA("Decal") or d:IsA("Texture") then
					d.Transparency = 1
				end
			end)
		end
	else
		pcall(function() settings().Rendering.QualityLevel = 7 end)
	end
end

--// Scanners
local function scanDupeDoors()
	if not Config.ESP.DupeDoor.Enabled then return end
	local rooms = safeFind(Workspace, "CurrentRooms")
	if not rooms then return end

	for i = 0, 100 do
		local room = safeFind(rooms, tostring(i))
		if room then
			local dupe = safeFind(room, "dupeDoor")
			if dupe and not dupe:GetAttribute("ESP_Marked") then
				for _, p in ipairs(dupe:GetDescendants()) do
					if p:IsA("BasePart") then
						local h = createHighlight(p, Config.ESP.DupeDoor.Color)
						if h then table.insert(Core.ESPObjects, h) end
					end
				end
				dupe:SetAttribute("ESP_Marked", true)
			end
		end
	end
end

local function scanKeys()
	if not Config.ESP.Key.Enabled then return end
	local assets = safeFind(Workspace, "Assets")
	if not assets then return end

	for _, dresser in ipairs(assets:GetChildren()) do
		if dresser.Name == "Dresser" then
			for _, drawer in ipairs(dresser:GetChildren()) do
				if drawer.Name == "DrawerContainer" or drawer.Name == "DrawerContalner" then
					for _, keyObj in ipairs(drawer:GetChildren()) do
						if keyObj.Name == "KeyObtain" or keyObj.Name == "KeyObtaln" then
							local hitbox = safeFind(keyObj, "Hitbox")
							if hitbox then
								local keyHitbox = safeFind(hitbox, "KeyNitbox") or safeFind(hitbox, "KeyHitbox")
								if keyHitbox and keyHitbox:IsA("BasePart") and not keyHitbox:GetAttribute("ESP_Marked") then
									local h = createHighlight(keyHitbox, Config.ESP.Key.Color)
									if h then table.insert(Core.ESPObjects, h) end
									keyHitbox:SetAttribute("ESP_Marked", true)
								end
							end
						end
					end
				end
			end
		end
	end
end

local function scanSnares()
	if not Config.ESP.Snare.Enabled then return end
	local rooms = safeFind(Workspace, "CurrentRooms")
	if not rooms then return end

	for i = 90, 99 do
		local room = safeFind(rooms, tostring(i))
		if room then
			local assets = safeFind(room, "Assets")
			if assets then
				for _, snare in ipairs(assets:GetChildren()) do
					if snare.Name == "Snare" then
						local snareChild = safeFind(snare, "Snare")
						if snareChild then
							local snareBase = safeFind(snareChild, "SnareBase")
							if snareBase and snareBase:IsA("BasePart") and not snareBase:GetAttribute("ESP_Marked") then
								local h = createHighlight(snareBase, Config.ESP.Snare.Color)
								if h then table.insert(Core.ESPObjects, h) end
								snareBase:SetAttribute("ESP_Marked", true)
							end
						end
					end
				end
			end
		end
	end
end

local function scanBreakers()
	if not Config.ESP.Breaker.Enabled then return end
	local rooms = safeFind(Workspace, "CurrentRooms")
	if not rooms then return end
	local room100 = safeFind(rooms, "100")
	if not room100 then return end

	local assets = safeFind(room100, "Assets")
	if assets then
		for _, d in ipairs(assets:GetDescendants()) do
			if (d.Name == "LiveBreakerPolePickup" or d.Name == "LiveBreakerPolePlckup") 
				and d:IsA("BasePart") 
				and not d:GetAttribute("ESP_Marked") then
				local h = createHighlight(d, Config.ESP.Breaker.Color)
				if h then table.insert(Core.ESPObjects, h) end
				d:SetAttribute("ESP_Marked", true)
			end
		end
	end
end

local function scanBooks()
	if not Config.ESP.Book.Enabled then return end
	local rooms = safeFind(Workspace, "CurrentRooms")
	if not rooms then return end
	local room50 = safeFind(rooms, "50")
	if not room50 then return end

	local assets = safeFind(room50, "Assets")
	if not assets then return end
	local bs = safeFind(assets, "Bookshelvesl") or safeFind(assets, "Bookshelves")
	if not bs then return end

	for _, shelf in ipairs(bs:GetChildren()) do
		local ms = safeFind(shelf, "Modular_Bookshelf")
		if ms then
			local books = safeFind(ms, "Books")
			if books then
				for _, book in ipairs(books:GetChildren()) do
					if book.Name == "LiveHintBook" and book:IsA("BasePart") and not book:GetAttribute("ESP_Marked") then
						local h = createHighlight(book, Config.ESP.Book.Color)
						if h then table.insert(Core.ESPObjects, h) end
						book:SetAttribute("ESP_Marked", true)
					end
				end
			end
		end
	end
end

--// Monitors
local function startRushMonitor()
	local active = false
	return RunService.RenderStepped:Connect(function()
		local rush = safeFind(Workspace, "RushMoving")
		local ambush = safeFind(Workspace, "AmbushMoving")

		if rush and Config.Entities.RushAlert.Enabled and not active then
			active = true
			notify("⚠️ RUSH INCOMING", 3)
			task.delay(3, function() active = false end)
		end
		if ambush and Config.Entities.AmbushAlert.Enabled and not active then
			active = true
			notify("⚠️ AMBUSH INCOMING", 3)
			task.delay(3, function() active = false end)
		end
	end)
end

local function startEyesMonitor()
	return RunService.RenderStepped:Connect(function()
		if not Config.Entities.EyesProtection.Enabled or not Camera or not RootPart then return end
		
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj.Name == "Eyes" and obj:IsA("BasePart") then
				local dirToEyes = (obj.Position - Camera.CFrame.Position).Unit
				local dot = dirToEyes:Dot(Camera.CFrame.LookVector)
				if dot > math.cos(math.rad(Config.Entities.EyesProtection.LookAwayAngle)) then
					if Config.Entities.EyesProtection.AutoLookAway then
						local perp = Vector3.new(Camera.CFrame.LookVector.Z, 0, -Camera.CFrame.LookVector.X).Unit
						Camera.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + perp)
					end
				end
			end
		end
	end)
end

local function startScreechMonitor()
	return RunService.Heartbeat:Connect(function()
		if not Config.Entities.ScreechAlert.Enabled then return end
		
		local variants = {"Screech", "ScreechRetro", "ScreechRushMode"}
		for _, v in ipairs(variants) do
			for _, d in ipairs(Workspace:GetDescendants()) do
				if d.Name == v and not Core.ScreechAlerted[v] then
					Core.ScreechAlerted[v] = true
					notify("👁️ SCREECH - " .. v, 2)
					if Config.Entities.ScreechAlert.AutoLook and d:IsA("BasePart") and RootPart then
						Camera.CFrame = CFrame.new(Camera.CFrame.Position, d.Position)
					end
					break
				end
			end
		end
		
		for v in pairs(Core.ScreechAlerted) do
			local found = false
			for _, d in ipairs(Workspace:GetDescendants()) do
				if d.Name == v then found = true break end
			end
			if not found then Core.ScreechAlerted[v] = nil end
		end
	end)
end

local function checkFigure()
	if not Config.FigureAvoidance.Enabled or not RootPart then return end
	local rooms = safeFind(Workspace, "CurrentRooms")
	if not rooms then return end
	local r50 = safeFind(rooms, "50")
	if not r50 then return end

	local fs = safeFind(r50, "FigureSetup") or safeFind(r50, "FlgureSetup")
	if not fs then return end
	local rig = safeFind(fs, "FigureRig")
	if not rig then return end
	local hrp = safeFind(rig, "HumanoidRootPart")
	
	if hrp then
		local dist = (hrp.Position - RootPart.Position).Magnitude
		if dist < Config.FigureAvoidance.AvoidRadius then
			notify("⚠️ FIGURE NEARBY (" .. math.floor(dist) .. "m)", 2)
		end
	end
end

--// GUI
local function buildGUI()
	-- УДАЛЯЕМ СТАРЫЙ GUI ЕСЛИ ЕСТЬ
	if PlayerGui:FindFirstChild("HobbitGUI") then
		PlayerGui.HobbitGUI:Destroy()
	end

	local gui = Instance.new("ScreenGui")
	gui.Name = "HobbitGUI"
	gui.ResetOnSpawn = false
	gui.Parent = PlayerGui

	local main = Instance.new("Frame")
	main.Size = UDim2.new(0, 250, 0, 400)
	main.Position = UDim2.new(0, 10, 0.5, -200)
	main.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
	main.BorderSizePixel = 0
	main.Active = true
	main.Draggable = true
	main.Parent = gui

	Instance.new("UICorner").CornerRadius = UDim.new(0, 8).Parent = main

	local title = Instance.new("TextLabel")
	title.Size = UDim2.new(1, 0, 0, 35)
	title.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	title.Text = "Hobbit Menu v4.0"
	title.TextColor3 = Color3.fromRGB(255, 255, 255)
	title.TextSize = 18
	title.Font = Enum.Font.GothamBold
	title.Parent = main

	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, -10, 1, -40)
	scroll.Position = UDim2.new(0, 5, 0, 40)
	scroll.BackgroundTransparency = 1
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 3
	scroll.CanvasSize = UDim2.new(0, 0, 0, 550)
	scroll.Parent = main

	local list = Instance.new("UIListLayout")
	list.Padding = UDim.new(0, 4)
	list.Parent = scroll

	local function addSection(text)
		local sec = Instance.new("TextLabel")
		sec.Size = UDim2.new(1, -10, 0, 25)
		sec.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		sec.Text = "  " .. text
		sec.TextColor3 = Color3.fromRGB(255, 255, 255)
		sec.TextSize = 14
		sec.Font = Enum.Font.GothamBold
		sec.TextXAlignment = Enum.TextXAlignment.Left
		sec.Parent = scroll
		Instance.new("UICorner", sec)
	end

	local function addToggle(text, default, callback)
		local frame = Instance.new("Frame")
		frame.Size = UDim2.new(1, -10, 0, 25)
		frame.BackgroundTransparency = 1
		frame.Parent = scroll

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(0.65, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.Text = "  " .. text
		label.TextColor3 = Color3.fromRGB(200, 200, 200)
		label.TextSize = 13
		label.Font = Enum.Font.Gotham
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = frame

		local btn = Instance.new("TextButton")
		btn.Size = UDim2.new(0, 60, 0, 20)
		btn.Position = UDim2.new(1, -65, 0.5, -10)
		btn.BackgroundColor3 = default and Color3.fromRGB(0, 180, 0) or Color3.fromRGB(180, 0, 0)
		btn.Text = default and "ON" or "OFF"
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.TextSize = 12
		btn.Font = Enum.Font.GothamBold
		btn.BorderSizePixel = 0
		btn.Parent = frame
		Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 3)

		local state = default
		btn.MouseButton1Click:Connect(function()
			state = not state
			btn.BackgroundColor3 = state and Color3.fromRGB(0, 180, 0) or Color3.fromRGB(180, 0, 0)
			btn.Text = state and "ON" or "OFF"
			callback(state)
		end)
	end

	-- ESP Section
	addSection("🔍 ESP SETTINGS")
	addToggle("Dupe Doors", Config.ESP.DupeDoor.Enabled, function(v) 
		Config.ESP.DupeDoor.Enabled = v
		if not v then clearESP() end
	end)
	addToggle("Keys", Config.ESP.Key.Enabled, function(v) 
		Config.ESP.Key.Enabled = v
		if not v then clearESP() end
	end)
	addToggle("Snares", Config.ESP.Snare.Enabled, function(v) 
		Config.ESP.Snare.Enabled = v
		if not v then clearESP() end
	end)
	addToggle("Breakers", Config.ESP.Breaker.Enabled, function(v) 
		Config.ESP.Breaker.Enabled = v
		if not v then clearESP() end
	end)
	addToggle("Books", Config.ESP.Book.Enabled, function(v) 
		Config.ESP.Book.Enabled = v
		if not v then clearESP() end
	end)

	-- Entities
	addSection("👻 ENTITIES")
	addToggle("Rush Alert", Config.Entities.RushAlert.Enabled, function(v) Config.Entities.RushAlert.Enabled = v end)
	addToggle("Ambush Alert", Config.Entities.AmbushAlert.Enabled, function(v) Config.Entities.AmbushAlert.Enabled = v end)
	addToggle("Eyes Protection", Config.Entities.EyesProtection.Enabled, function(v) Config.Entities.EyesProtection.Enabled = v end)
	addToggle("Screech Alert", Config.Entities.ScreechAlert.Enabled, function(v) Config.Entities.ScreechAlert.Enabled = v end)

	-- Room 50
	addSection("📚 ROOM 50")
	addToggle("Figure Avoidance", Config.FigureAvoidance.Enabled, function(v) Config.FigureAvoidance.Enabled = v end)

	-- Player Mods
	addSection("⚡ PLAYER MODS")
	addToggle("FullBright", Config.FullBright.Enabled, function(v) 
		Config.FullBright.Enabled = v
		toggleFullBright(v)
	end)
	addToggle("FPS Booster", Config.FPSBooster.Enabled, function(v) 
		Config.FPSBooster.Enabled = v
		toggleFPSBoost(v)
	end)
	addToggle("Speed Hack (24)", Config.CustomSpeed.Enabled, function(v) 
		Config.CustomSpeed.Enabled = v
		if Humanoid then
			Humanoid.WalkSpeed = v and Config.CustomSpeed.Speed or 16
		end
	end)

	-- Minimize btn
	local minBtn = Instance.new("TextButton")
	minBtn.Size = UDim2.new(0, 25, 0, 25)
	minBtn.Position = UDim2.new(1, -30, 0, 5)
	minBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
	minBtn.Text = "_"
	minBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
	minBtn.Font = Enum.Font.GothamBold
	minBtn.TextSize = 16
	minBtn.BorderSizePixel = 0
	minBtn.Parent = main
	Instance.new("UICorner", minBtn)

	local min = false
	minBtn.MouseButton1Click:Connect(function()
		min = not min
		main.Size = min and UDim2.new(0, 250, 0, 40) or UDim2.new(0, 250, 0, 400)
		minBtn.Text = min and "□" or "_"
	end)
end

--// Main loop
local function periodicScan()
	while true do
		pcall(scanDupeDoors)
		pcall(scanKeys)
		pcall(scanSnares)
		pcall(scanBreakers)
		pcall(scanBooks)
		pcall(checkFigure)
		task.wait(1)
	end
end

--// Init
local function init()
	buildGUI()
	toggleFullBright(Config.FullBright.Enabled)
	
	table.insert(Core.Connections, startRushMonitor())
	table.insert(Core.Connections, startEyesMonitor())
	table.insert(Core.Connections, startScreechMonitor())
	
	if Humanoid then
		table.insert(Core.Connections, Humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
			if Config.CustomSpeed.Enabled and Humanoid.WalkSpeed ~= Config.CustomSpeed.Speed then
				Humanoid.WalkSpeed = Config.CustomSpeed.Speed
			end
		end))
	end
	
	task.spawn(periodicScan)
	print("✅ Hobbit GUI v4.0 Loaded! Menu should be visible on screen")
end

--// Cleanup
LocalPlayer.CharacterRemoving:Connect(function()
	clearESP()
	for _, c in ipairs(Core.Connections) do
		pcall(function() c:Disconnect() end)
	end
	table.clear(Core.Connections)
end)

-- Start everything
init()
