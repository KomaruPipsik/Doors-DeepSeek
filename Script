end

--// Scanners
local function scanDupeDoors()
	if not Config.ESP.DupeDoor.Enabled then return end
	local rooms = safeFind(Workspace, "CurrentRooms")
	if not rooms then return end

	for i = 0, 100 do
		local room = safeFind(rooms, tostring(i))
		if room then
			local dupe = safeFind(room, "dupeDoor")
			if dupe and not dupe:GetAttribute("ESP_Marked") then
				for _, p in ipairs(dupe:GetDescendants()) do
					if p:IsA("BasePart") then
						local h = createHighlight(p, Config.ESP.DupeDoor.Color)
						if h then table.insert(Core.ESPObjects, h) end
					end
				end
				dupe:SetAttribute("ESP_Marked", true)
			end
		end
	end
end

local function scanKeys()
	if not Config.ESP.Key.Enabled then return end
	local assets = safeFind(Workspace, "Assets")
	if not assets then return end

	for _, dresser in ipairs(assets:GetChildren()) do
		if dresser.Name == "Dresser" then
			for _, drawer in ipairs(dresser:GetChildren()) do
				if drawer.Name == "DrawerContainer" or drawer.Name == "DrawerContalner" then
					for _, keyObj in ipairs(drawer:GetChildren()) do
						if keyObj.Name == "KeyObtain" or keyObj.Name == "KeyObtaln" then
							local hitbox = safeFind(keyObj, "Hitbox")
							if hitbox then
								local keyHitbox = safeFind(hitbox, "KeyNitbox") or safeFind(hitbox, "KeyHitbox")
								if keyHitbox and keyHitbox:IsA("BasePart") and not keyHitbox:GetAttribute("ESP_Marked") then
									local h = createHighlight(keyHitbox, Config.ESP.Key.Color)
									if h then table.insert(Core.ESPObjects, h) end
									keyHitbox:SetAttribute("ESP_Marked", true)
								end
							end
						end
					end
				end
			end
		end
	end
end

local function scanSnares()
	if not Config.ESP.Snare.Enabled then return end
	local rooms = safeFind(Workspace, "CurrentRooms")
	if not rooms then return end

	for i = 90, 99 do
		local room = safeFind(rooms, tostring(i))
		if room then
			local assets = safeFind(room, "Assets")
			if assets then
				for _, snare in ipairs(assets:GetChildren()) do
					if snare.Name == "Snare" then
						local snareChild = safeFind(snare, "Snare")
						if snareChild then
							local snareBase = safeFind(snareChild, "SnareBase")
							if snareBase and snareBase:IsA("BasePart") and not snareBase:GetAttribute("ESP_Marked") then
								local h = createHighlight(snareBase, Config.ESP.Snare.Color)
								if h then table.insert(Core.ESPObjects, h) end
								snareBase:SetAttribute("ESP_Marked", true)
							end
						end
					end
				end
			end
		end
	end
end

local function scanBreakers()
	if not Config.ESP.Breaker.Enabled then return end
	local rooms = safeFind(Workspace, "CurrentRooms")
	if not rooms then return end
	local room100 = safeFind(rooms, "100")
	if not room100 then return end

	local assets = safeFind(room100, "Assets")
	if assets then
		for _, d in ipairs(assets:GetDescendants()) do
			if (d.Name == "LiveBreakerPolePickup" or d.Name == "LiveBreakerPolePlckup") 
				and d:IsA("BasePart") 
				and not d:GetAttribute("ESP_Marked") then
				local h = createHighlight(d, Config.ESP.Breaker.Color)
				if h then table.insert(Core.ESPObjects, h) end
				d:SetAttribute("ESP_Marked", true)
			end
		end
	end
end

local function scanBooks()
	if not Config.ESP.Book.Enabled then return end
	local rooms = safeFind(Workspace, "CurrentRooms")
	if not rooms then return end
	local room50 = safeFind(rooms, "50")
	if not room50 then return end

	local assets = safeFind(room50, "Assets")
	if not assets then return end
	local bs = safeFind(assets, "Bookshelvesl") or safeFind(assets, "Bookshelves")
	if not bs then return end

	for _, shelf in ipairs(bs:GetChildren()) do
		local ms = safeFind(shelf, "Modular_Bookshelf")
		if ms then
			local books = safeFind(ms, "Books")
			if books then
				for _, book in ipairs(books:GetChildren()) do
					if book.Name == "LiveHintBook" and book:IsA("BasePart") and not book:GetAttribute("ESP_Marked") then
						local h = createHighlight(book, Config.ESP.Book.Color)
						if h then table.insert(Core.ESPObjects, h) end
						book:SetAttribute("ESP_Marked", true)
					end
				end
			end
		end
	end
end

--// Monitors
local function startRushMonitor()
	local active = false
	return RunService.RenderStepped:Connect(function()
		local rush = safeFind(Workspace, "RushMoving")
		local ambush = safeFind(Workspace, "AmbushMoving")

		if rush and Config.Entities.RushAlert.Enabled and not active then
			active = true
			notify("⚠️ RUSH INCOMING", 3)
			task.delay(3, function() active = false end)
		end
		if ambush and Config.Entities.AmbushAlert.Enabled and not active then
			active = true
			notify("⚠️ AMBUSH INCOMING", 3)
			task.delay(3, function() active = false end)
		end
	end)
end

local function startEyesMonitor()
	return RunService.RenderStepped:Connect(function()
		if not Config.Entities.EyesProtection.Enabled or not Camera or not RootPart then return end
		
		for _, obj in ipairs(Workspace:GetDescendants()) do
			if obj.Name == "Eyes" and obj:IsA("BasePart") then
				local dirToEyes = (obj.Position - Camera.CFrame.Position).Unit
				local dot = dirToEyes:Dot(Camera.CFrame.LookVector)
				if dot > math.cos(math.rad(Config.Entities.EyesProtection.LookAwayAngle)) then
					if Config.Entities.EyesProtection.AutoLookAway then
						local perp = Vector3.new(Camera.CFrame.LookVector.Z, 0, -Camera.CFrame.LookVector.X).Unit
						Camera.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + perp)
					end
				end
			end
		end
	end)
end

local function startScreechMonitor()
	return RunService.Heartbeat:Connect(function()
		if not Config.Entities.ScreechAlert.Enabled then return end
		
		local variants = {"Screech", "ScreechRetro", "ScreechRushMode"}
		for _, v in ipairs(variants) do
			for _, d in ipairs(Workspace:GetDescendants()) do
				if d.Name == v and not Core.ScreechAlerted[v] then
					Core.ScreechAlerted[v] = true
					notify("👁️ SCREECH - " .. v, 2)
					if Config.Entities.ScreechAlert.AutoLook and d:IsA("BasePart") and RootPart then
						Camera.CFrame = CFrame.new(Camera.CFrame.Position, d.Position)
					end
					break
				end
			end
		end
		
		for v in pairs(Core.ScreechAlerted) do
			local found = false
			for _, d in ipairs(Workspace:GetDescendants()) do
				if d.Name == v then found = true break end
			end
			if not found then Core.ScreechAlerted[v] = nil end
		end
	end)
end

local function checkFigure()
	if not Config.FigureAvoidance.Enabled or not RootPart then return end
	local rooms = safeFind(Workspace, "CurrentRooms")
	if not rooms then return end
	local r50 = safeFind(rooms, "50")
	if not r50 then return end

	local fs = safeFind(r50, "FigureSetup") or safeFind(r50, "FlgureSetup")
	if not fs then return end
	local rig = safeFind(fs, "FigureRig")
	if not rig then return end
	local hrp = safeFind(rig, "HumanoidRootPart")
	
	if hrp then
		local dist = (hrp.Position - RootPart.Position).Magnitude
		if dist < Config.FigureAvoidance.AvoidRadius then
			notify("⚠️ FIGURE NEARBY (" .. math.floor(dist) .. "m)", 2)
		end
	end
end

