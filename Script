local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer

-- Определение контейнера (CoreGui или PlayerGui)
local targetParent = nil
local success = pcall(function()
	targetParent = CoreGui
end)

if not success or not targetParent then
	targetParent = player:FindFirstChildOfClass("PlayerGui") or player:WaitForChild("PlayerGui", 5)
end

-- Удаление старой копии GUI при повторном запуске
if targetParent and targetParent:FindFirstChild("DoorsBaseMenu") then
	targetParent.DoorsBaseMenu:Destroy()
end

-- Создание ScreenGui
local screenGui = Instance.new("ScreenGui")
screenGui.Name = "DoorsBaseMenu"
screenGui.ResetOnSpawn = false
screenGui.DisplayOrder = 999999
screenGui.Parent = targetParent

-- Главная рамка (Центр экрана)
local mainFrame = Instance.new("Frame")
mainFrame.Name = "MainFrame"
mainFrame.Size = UDim2.new(0, 320, 0, 200)
mainFrame.Position = UDim2.new(0.5, -160, 0.5, -100)
mainFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
mainFrame.BorderColor3 = Color3.fromRGB(0, 170, 255)
mainFrame.BorderSizePixel = 2
mainFrame.Active = true
mainFrame.Draggable = true
mainFrame.Visible = true
mainFrame.Parent = screenGui

-- Шапка
local titleBar = Instance.new("Frame")
titleBar.Size = UDim2.new(1, 0, 0, 35)
titleBar.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
titleBar.BorderSizePixel = 0
titleBar.Parent = mainFrame

local titleText = Instance.new("TextLabel")
titleText.Size = UDim2.new(1, -10, 1, 0)
titleText.Position = UDim2.new(0, 10, 0, 0)
titleText.BackgroundTransparency = 1
titleText.Font = Enum.Font.SourceSansBold
titleText.Text = "DOORS MENU"
titleText.TextColor3 = Color3.fromRGB(255, 255, 255)
titleText.TextSize = 18
titleText.TextXAlignment = Enum.TextXAlignment.Left
titleText.Parent = titleBar

-- Информационный текст
local statusText = Instance.new("TextLabel")
statusText.Size = UDim2.new(1, -20, 0, 50)
statusText.Position = UDim2.new(0, 10, 0, 45)
statusText.BackgroundTransparency = 1
statusText.Font = Enum.Font.SourceSans
statusText.Text = "МЕНЮ ОТОБРАЖАЕТСЯ\nСкрытие: RightShift или Insert"
statusText.TextColor3 = Color3.fromRGB(0, 255, 127)
statusText.TextSize = 16
statusText.TextWrapped = true
statusText.Parent = mainFrame

-- Тестовая кнопка
local testBtn = Instance.new("TextButton")
testBtn.Size = UDim2.new(1, -40, 0, 40)
testBtn.Position = UDim2.new(0, 20, 0, 110)
testBtn.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
testBtn.BorderColor3 = Color3.fromRGB(80, 80, 100)
testBtn.Font = Enum.Font.SourceSansBold
testBtn.Text = "Проверка клика"
testBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
testBtn.TextSize = 16
testBtn.Parent = mainFrame

testBtn.MouseButton1Click:Connect(function()
	testBtn.Text = "Клик работает!"
	testBtn.BackgroundColor3 = Color3.fromRGB(0, 150, 75)
end)

-- Переключение видимости по клавишам RightShift / Insert
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.KeyCode == Enum.KeyCode.RightShift or input.KeyCode == Enum.KeyCode.Insert then
		mainFrame.Visible = not mainFrame.Visible
	end
end)

print("[DoorsMenu] UI успешно заинжекчен в: " .. tostring(targetParent:GetFullName()))
