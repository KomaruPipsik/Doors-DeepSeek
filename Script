--// Main loop
local function periodicScan()
	while true do
		pcall(scanDupeDoors)
		pcall(scanKeys)
		pcall(scanSnares)
		pcall(scanBreakers)
		pcall(scanBooks)
		pcall(checkFigure)
		task.wait(1)
	end
end

--// Init
local function init()
	buildGUI()
	toggleFullBright(Config.FullBright.Enabled)
	
	table.insert(Core.Connections, startRushMonitor())
	table.insert(Core.Connections, startEyesMonitor())
	table.insert(Core.Connections, startScreechMonitor())
	
	if Humanoid then
		table.insert(Core.Connections, Humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
			if Config.CustomSpeed.Enabled and Humanoid.WalkSpeed ~= Config.CustomSpeed.Speed then
				Humanoid.WalkSpeed = Config.CustomSpeed.Speed
			end
		end))
	end
	
	task.spawn(periodicScan)
	print("✅ Hobbit GUI v4.0 Loaded! Menu should be visible on screen")
end

