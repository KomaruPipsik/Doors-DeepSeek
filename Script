--// Periodic Scanning
local function PeriodicScan()
	while true do
		pcall(ScanDupeDoors)
		pcall(ScanKeys)
		pcall(ScanSnares)
		pcall(ScanBreakers)
		pcall(ScanBooks)
		pcall(MonitorFigure)
		task.wait(1)
	end
end

--// Initialize
local function Initialize()
	CreateGUI()
	SetupFullBright()

	-- Start monitors
	table.insert(Core.ActiveConnections, MonitorRushAmbush())
	table.insert(Core.ActiveConnections, MonitorEyes())
	table.insert(Core.ActiveConnections, MonitorScreech())

	-- Start periodic scanning
	task.spawn(PeriodicScan)

	-- Speed monitor
	if Humanoid then
		Core.SpeedConnection = Humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
			if Config.CustomSpeed.Enabled and Humanoid.
