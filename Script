--// Feature Implementations
local function SetupFullBright()
	if Config.FullBright.Enabled then
		Lighting.Brightness = 0.3
		Lighting.Ambient = Color3.fromRGB(180, 180, 180)
		Lighting.OutdoorAmbient = Color3.fromRGB(180, 180, 180)
		Lighting.FogEnd = 10000
		Lighting.FogStart = 0
		pcall(function()
			Lighting.ClockTime = 14
			Lighting.ExposureCompensation = 0.5
		end)
	else
		Lighting.Brightness = 1
		Lighting.Ambient = Color3.fromRGB(0, 0, 0)
		Lighting.OutdoorAmbient = Color3.fromRGB(70, 70, 70)
	end
end

local function SetupFPSBooster()
	if Config.FPSBooster.Enabled then
		pcall(function()
			settings().Rendering.QualityLevel = 1
		end)
		for _, descendant in ipairs(Workspace:GetDescendants()) do
			pcall(function()
				if descendant:IsA("BasePart") and descendant.Material ~= Enum.Material.SmoothPlastic then
					descendant.Material = Enum.Material.SmoothPlastic
				elseif descendant:IsA("Decal") or descendant:IsA("Texture") then
					descendant.Transparency = 1
				end
			end)
		end
	else
		pcall(function()
			settings().Rendering.QualityLevel = 7
		end)
	end
end

--// Scanning Functions
local function ScanDupeDoors()
	local currentRooms = SafeFind(Workspace, "CurrentRooms")
	if not currentRooms or not Config.ESP.DupeDoor.Enabled then return end

	for i = 0, 100 do
		local room = SafeFind(currentRooms, tostring(i))
		if room then
			local dupeDoor = SafeFind(room, "dupeDoor")
			if dupeDoor and not dupeDoor:GetAttribute("ESP_Marked") then
				for _, part in ipairs(dupeDoor:GetDescendants()) do
					if part:IsA("BasePart") then
						local esp = CreateESP(part, Config.ESP.DupeDoor.Color)
						if esp then table.insert(Core.ESPObjects, esp) end
					end
				end
				dupeDoor:SetAttribute("ESP_Marked", true)
			end
		end
	end
end

local function ScanKeys()
	if not Config.ESP.Key.Enabled then return end

	local assets = SafeFind(Workspace, "Assets")
	if not assets then return end

	for _, dresser in ipairs(assets:GetChildren()) do
		if dresser.Name == "Dresser" then
			for _, drawer in ipairs(dresser:GetChildren()) do
				if drawer.Name == "DrawerContainer" or drawer.Name == "DrawerContalner" then
					for _, keyObj in ipairs(drawer:GetChildren()) do
						if keyObj.Name == "KeyObtain" or keyObj.Name == "KeyObtaln" then
							local hitbox = SafeFind(keyObj, "Hitbox")
							if hitbox then
								local keyHitbox = SafeFind(hitbox, "KeyNitbox") or SafeFind(hitbox, "KeyHitbox")
								if keyHitbox and keyHitbox:IsA("BasePart") and not keyHitbox:GetAttribute("ESP_Marked") then
									local esp = CreateESP(keyHitbox, Config.ESP.Key.Color)
									if esp then table.insert(Core.ESPObjects, esp) end
									keyHitbox:SetAttribute("ESP_Marked", true)
								end
							end
						end
					end
				end
			end
		end
	end
end

local function ScanSnares()
	if not Config.ESP.Snare.Enabled then return end

	local currentRooms = SafeFind(Workspace, "CurrentRooms")
	if not currentRooms then return end

	for i = 90, 99 do
		local room = SafeFind(currentRooms, tostring(i))
		if room then
			local assets = SafeFind(room, "Assets")
			if assets then
				for _, snare in ipairs(assets:GetChildren()) do
					if snare.Name == "Snare" then
						local snareChild = SafeFind(snare, "Snare")
						if snareChild then
							local snareBase = SafeFind(snareChild, "SnareBase")
							if snareBase and snareBase:IsA("BasePart") and not snareBase:GetAttribute("ESP_Marked") then
								local esp = CreateESP(snareBase, Config.ESP.Snare.Color)
								if esp then table.insert(Core.ESPObjects, esp) end
								snareBase:SetAttribute("ESP_Marked", true)
							end
						end
					end
				end
			end
		end
	end
end

local function ScanBreakers()
	if not Config.ESP.Breaker.Enabled then return end

	local currentRooms = SafeFind(Workspace, "CurrentRooms")
	if not currentRooms then return end

	local room100 = SafeFind(currentRooms, "100")
	if not room100 then return end

	local assets = SafeFind(room100, "Assets")
	if assets then
		for _, descendant in ipairs(assets:GetDescendants()) do
			if (descendant.Name == "LiveBreakerPolePickup" or descendant.Name == "LiveBreakerPolePlckup") 
				and descendant:IsA("BasePart") 
				and not descendant:GetAttribute("ESP_Marked") then
				local esp = CreateESP(descendant, Config.ESP.Breaker.Color)
				if esp then table.insert(Core.ESPObjects, esp) end
				descendant:SetAttribute("ESP_Marked", true)
			end
		end
	end
end

local function ScanBooks()
	if not Config.ESP.Book.Enabled then return end

	local currentRooms = SafeFind(Workspace, "CurrentRooms")
	if not currentRooms then return end

	local room50 = SafeFind(currentRooms, "50")
	if not room50 then return end

	local assets = SafeFind(room50, "Assets")
	if not assets then return end

	local bookshelves = SafeFind(assets, "Bookshelvesl") or SafeFind(assets, "Bookshelves")
	if not bookshelves then return end

	for _, shelf in ipairs(bookshelves:GetChildren()) do
		local modularShelf = SafeFind(shelf, "Modular_Bookshelf")
		if modularShelf then
			local books = SafeFind(modularShelf, "Books")
			if books then
				for _, book in ipairs(books:GetChildren()) do
					if book.Name == "LiveHintBook" and book:IsA("BasePart") and not book:GetAttribute("ESP_Marked") then
						local esp = CreateESP(book, Config.ESP.Book.Color)
						if esp then table.insert(Core.ESPObjects, esp) end
						book:SetAttribute("ESP_Marked", true)
					end
				end
			end
		end
	end
end

--// Entity Monitors
local function MonitorRushAmbush()
	local active = false
	return RunService.RenderStepped:Connect(function()
		local rush = SafeFind(Workspace, "RushMoving")
		local ambush = SafeFind(Workspace, "AmbushMoving")

		if rush and Config.Entities.RushAlert.Enabled and not active then
			active = true
			DisplayNotification("⚠️ RUSH INCOMING", 3)
			task.delay(3, function() active = false end)
		end

		if ambush and Config.Entities.AmbushAlert.Enabled and not active then
			active = true
			DisplayNotification("⚠️ AMBUSH INCOMING", 3)
			task.delay(3, function() active = false end)
		end
	end)
end

local function MonitorEyes()
	return RunService.RenderStepped:Connect(function()
		if not Config.Entities.EyesProtection.Enabled or not Camera or not RootPart then return end

		for _, instance in ipairs(Workspace:GetDescendants()) do
			if instance.Name == "Eyes" and instance:IsA("BasePart") then
				local directionToEyes = (instance.Position - Camera.CFrame.Position).Unit
				local cameraLookVector = Camera.CFrame.LookVector
				local dotProduct = directionToEyes:Dot(cameraLookVector)

				if dotProduct > math.cos(math.rad(Config.Entities.EyesProtection.LookAwayAngle)) then
					if Config.Entities.EyesProtection.AutoLookAway then
						local perpendicularVector = Vector3.new(cameraLookVector.Z, 0, -cameraLookVector.X).Unit
						Camera.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + perpendicularVector)
					end
				end
			end
		end
	end)
end

local function MonitorScreech()
	return RunService.Heartbeat:Connect(function()
		if not Config.Entities.ScreechAlert.Enabled then return end

		local variants = {"Screech", "ScreechRetro", "ScreechRushMode"}

		for _, variant in ipairs(variants) do
			for _, descendant in ipairs(Workspace:GetDescendants()) do
				if descendant.Name == variant and not Core.ScreechAlerted[variant] then
					Core.ScreechAlerted[variant] = true
					DisplayNotification("👁️ SCREECH SPAWNED - " .. variant, 2)

					if Config.Entities.ScreechAlert.AutoLook and descendant:IsA("BasePart") and RootPart then
						Camera.CFrame = CFrame.new(Camera.CFrame.Position, descendant.Position)
					end
					break
				end
			end
		end

		-- Clear stale alerts
		for variant, _ in pairs(Core.ScreechAlerted) do
			local found = false
			for _, descendant in ipairs(Workspace:GetDescendants()) do
				if descendant.Name == variant then
					found = true
					break
				end
			end
			if not found then
				Core.ScreechAlerted[variant] = nil
			end
		end
	end)
end

local function MonitorFigure()
	if not Config.FigureAvoidance.Enabled then return end

	local currentRooms = SafeFind(Workspace, "CurrentRooms")
	if not currentRooms then return end

	local room50 = SafeFind(currentRooms, "50")
	if not room50 then return end

	local figureSetup = SafeFind(room50, "FigureSetup") or SafeFind(room50, "FlgureSetup")
	if not figureSetup then return end

	local figureRig = SafeFind(figureSetup, "FigureRig")
	if not figureRig then return end

	local hrp = SafeFind(figureRig, "HumanoidRootPart")
	if hrp and RootPart then
		local distance = (hrp.Position - RootPart.Position).Magnitude
		if distance < Config.FigureAvoidance.AvoidRadius then
			DisplayNotification("⚠️ FIGURE NEARBY (" .. math.floor(distance) .. "m)", 2)
		end
	end
end

