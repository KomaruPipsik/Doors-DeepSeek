--  DESCENDANT HANDLER
-- ══════════════════════════════════════════════
local function HandleDescendant(desc)
    if desc.Name == "Door" and desc:IsA("Model") then
        if doorsESPEnabled then HandleDoor(desc) end
        return
    end
    if desc.Name == "KeyObtain" and keyESPEnabled then
        MakeItemESP(desc,"KeyESP","🔑 КЛЮЧ",Color3.fromRGB(255,220,0)); return
    end
    if (desc.Name=="Dresser" or desc.Name=="DrawerContainer") and keyESPEnabled then
        local k=desc:FindFirstChild("KeyObtain",true)
        if k then MakeItemESP(k,"KeyESP","🔑 КЛЮЧ",Color3.fromRGB(255,220,0)) end
        return
    end
    if desc.Name=="LeverForGate" and leverESPEnabled then
        local part=GetPrimaryPart(desc)
        if part then
            MakeESP(part,"LeverESP","🔧 РЫЧАГ",Color3.fromRGB(255,255,0))
            MakeHighlight(desc,"LeverESP",Color3.fromRGB(255,255,0))
            desc.AncestryChanged:Connect(function()
                if not desc.Parent then RemoveESP(part,"LeverESP"); RemoveHighlight(desc,"LeverESP") end
            end)
        end
        return
    end
    if desc.Name=="LiveHintBook" and booksESP then
        MakeItemESP(desc,"BookESP","📖 КНИГА",Color3.fromRGB(0,210,255)); return
    end
    if desc.Name=="CrucifixWall" and crucifixESP then
        MakeItemESP(desc,"CrucifixESP","✝ КРЕСТ",Color3.fromRGB(255,200,50)); return
    end
    if desc.Name=="Snare" and snareESP then
        local base=desc:FindFirstChild("SnareBase") or desc
        local part=GetPrimaryPart(base) or base
        MakeESP(part,"SnareESP","⚠ ЛОВУШКА",Color3.fromRGB(255,128,0)); return
    end
    if desc.Name=="LiveBreakerPolePickup" and polesESP then
        local part=GetPrimaryPart(desc) or desc
        MakeESP(part,"PoleESP","⚡ РЫЧАГ 100",Color3.fromRGB(60,255,60)); return
    end

    -- ── 2 ЭТАЖ ──────────────────────────────

    -- Нора мыши: Assets > MouseHole
    if desc.Name=="MouseHole" and mouseHoleESP then
        MakeItemESP(desc,"MouseHoleESP","🕳 НОРА",Color3.fromRGB(180,120,60))
        return
    end

    -- Батарея: Assets > Locker_Small > Battery
    if desc.Name=="Locker_Small" and batteryESP then
        local bat=desc:FindFirstChild("Battery",true)
        if bat then MakeItemESP(bat,"BatteryESP","🔋 БАТАРЕЯ",Color3.fromRGB(100,255,100)) end
        return
    end

    -- GiggleCeiling — в Assets комнаты
    if desc.Name=="GiggleCeiling" and gigglesESP then
        MakeItemESP(desc,"GiggleESP","😂 ГИГГЛ",Color3.fromRGB(255,80,200)); return
    end

    -- MinesGenerator — в Assets комнаты
    if desc.Name=="MinesGenerator" and minesESP then
        MakeItemESP(desc,"MinesGenESP","⚙ ГЕНЕРАТОР",Color3.fromRGB(255,165,0)); return
    end

    -- MinesAnchor — прямо внутри _NestHandler (который в комнате/Assets)
    if desc.Name=="MinesAnchor" and floor2ESPEnabled then
        MakeItemESP(desc,"MinesAnchorESP","🔫 АВТОМАТ",Color3.fromRGB(255,50,50)); return
    end

    -- Grumbo — внутри Grumbles > _NestHandler
    if desc.Name=="Grumbo" and grumboESP then
        -- Grumbo это Model — ищем любой BasePart внутри для надписи
        local part = desc:FindFirstChildWhichIsA("BasePart", true)
        if part then
            MakeESP(part,"GrumboESP","👾 BIG GRUMBLE",Color3.fromRGB(200,0,255))
        end
        -- Highlight прямо на модель Grumbo
        if desc:IsA("Model") then
            MakeHighlight(desc,"GrumboESP",Color3.fromRGB(200,0,255))
        end
        desc.AncestryChanged:Connect(function()
            if not desc.Parent then
                if part then RemoveESP(part,"GrumboESP") end
                RemoveHighlight(desc,"GrumboESP")
            end
        end)
        return
    end

    -- Вентили/насосы 100 комнаты — WaterPump или Waterfall
    if (desc.Name=="WaterPump" or desc.Name=="Waterfall") and waterpumpESP then
        local target = desc:IsA("Model") and desc or desc.Parent
        local part = desc:FindFirstChildWhichIsA("BasePart",true) or (desc:IsA("BasePart") and desc)
        if part then
            MakeESP(part,"WaterPumpESP","💧 ВЕНТИЛЬ",Color3.fromRGB(0,180,255))
        end
        if target and target:IsA("Model") then
            MakeHighlight(target,"WaterPumpESP",Color3.fromRGB(0,180,255))
        end
        desc.AncestryChanged:Connect(function()
            if not desc.Parent then
                if part then RemoveESP(part,"WaterPumpESP") end
                if target then RemoveHighlight(target,"WaterPumpESP") end
            end
        end)
        return
    end

    -- Золото в Loot: Assets > Loot > FloorLootItem > GoldPile
    if desc.Name=="FloorLootItem" and goldLootESP then
        task.spawn(function()
            task.wait(0.2)
            if not desc.Parent then return end
            local gp = desc:FindFirstChild("GoldPile",true)
            if not gp then return end
            local part = GetPrimaryPart(gp) or gp:FindFirstChildWhichIsA("BasePart",true)
            if part and not part:FindFirstChild("GoldLootESP") then
                MakeESP(part,"GoldLootESP","💰 ЗОЛОТО",Color3.fromRGB(255,215,0))
                MakeHighlight(gp,"GoldLootESP",Color3.fromRGB(255,215,0))
                desc.AncestryChanged:Connect(function()
                    if not desc.Parent then
                        RemoveESP(part,"GoldLootESP")
                        RemoveHighlight(gp,"GoldLootESP")
                    end
                end)
            end
        end)
        return
    end
    -- Также ловим GoldPile напрямую внутри Loot
    if desc.Name=="GoldPile" and goldLootESP then
        local part = GetPrimaryPart(desc) or desc:FindFirstChildWhichIsA("BasePart",true)
        if part and not part:FindFirstChild("GoldLootESP") then
            MakeESP(part,"GoldLootESP","💰 ЗОЛОТО",Color3.fromRGB(255,215,0))
            MakeHighlight(desc,"GoldLootESP",Color3.fromRGB(255,215,0))
            desc.AncestryChanged:Connect(function()
                if not desc.Parent then
                    RemoveESP(part,"GoldLootESP")
                    RemoveHighlight(desc,"GoldLootESP")
                end
            end)
        end
    -- Новые предметы
    TryItemESP(desc)
end

