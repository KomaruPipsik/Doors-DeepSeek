-- ── BASH MOVING ────────────────────────────────────────
local bashActive=false; local bashSavedY=nil; local bashPlt=nil
local BASH_OFFSET=16; local BASH_SPEED=2  -- 2 блока в секунду → 16 блоков = 8 сек вниз

local function StartBash(obj)
    if F.bashNotif then Notif("💥 BASH!","BashMoving появился!") end
    if F.bash and HRP and not bashActive then
        bashActive=true; bashSavedY=HRP.Position.Y
        bashPlt=Instance.new("Part"); bashPlt.Size=Vector3.new(8,0.4,8)
        bashPlt.Anchored=true; bashPlt.CanCollide=true; bashPlt.Transparency=0.4
        bashPlt.BrickColor=BrickColor.new("Bright orange"); bashPlt.Material=Enum.Material.Neon
        bashPlt.Parent=Workspace
        -- Плавно вниз 16 блоков за 8 сек (2 блока/сек)
        local dur=BASH_OFFSET/BASH_SPEED
        SmoothY(bashSavedY, bashSavedY-BASH_OFFSET, dur, function(y)
            if HRP then HRP.CFrame=CFrame.new(HRP.Position.X,y,HRP.Position.Z) end
            if bashPlt then bashPlt.CFrame=CFrame.new(HRP.Position.X,HRP.Position.Y-3.2,HRP.Position.Z) end
        end, function()
            -- Подождём пока BashMoving не исчезнет сам
        end)
    end
    obj.AncestryChanged:Connect(function()
        if not obj.Parent and bashActive then
            bashActive=false
            if HRP and bashSavedY then
                local fy=HRP.Position.Y
                SmoothY(fy, bashSavedY, BASH_OFFSET/BASH_SPEED, function(y)
                    if HRP then HRP.CFrame=CFrame.new(HRP.Position.X,y,HRP.Position.Z) end
                    if bashPlt then bashPlt.CFrame=CFrame.new(HRP.Position.X,HRP.Position.Y-3.2,HRP.Position.Z) end
                end, function()
                    bypassAntiTp=false; bashSavedY=nil
                    if bashPlt then bashPlt:Destroy(); bashPlt=nil end
                end)
            else
                bypassAntiTp=false
            end
        end
    end)
end

Workspace.ChildAdded:Connect(function(obj)
    if obj.Name=="BashMoving" then StartBash(obj) end
end)
for _,obj in ipairs(Workspace:GetChildren()) do
    if obj.Name=="BashMoving" then StartBash(obj) end
end

