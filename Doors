local function SetPlayerESP(plr, enabled)
	if plr == Player then return end
	local char = plr.Character
	if not char then return end

	local hrp = char:FindFirstChild("HumanoidRootPart")
	if enabled then
		if hrp then MakeESP(hrp, "PlayerESP", "👤 " .. plr.Name, Color3.fromRGB(100, 200, 255)) end
		-- Обводка
		if not char:FindFirstChild("PlayerHL") then
			local hl = Instance.new("SelectionBox")
			hl.Name = "PlayerHL"
			hl.Adornee = char
			hl.Color3 = Color3.fromRGB(100, 200, 255)
			hl.LineThickness = 0.04
			hl.SurfaceTransparency = 0.8
			hl.SurfaceColor3 = Color3.fromRGB(100, 200, 255)
			hl.Parent = char
		end
	else
		if hrp then RemoveESP(hrp, "PlayerESP") end
		local hl = char:FindFirstChild("PlayerHL")
		if hl then hl:Destroy() end
	end
end

