-- ── ESP CORE ───────────────────────────────────────────
local function GPP(obj)
    if obj:IsA("BasePart") then return obj end
    return obj:FindFirstChildWhichIsA("BasePart",true)
end

local function MakeESP(part,tag,text,color)
    if not part or not part.Parent then return end
    if part:FindFirstChild(tag) then return end
    local b=Instance.new("BillboardGui"); b.Name=tag
    b.Size=UDim2.new(0,150,0,38); b.AlwaysOnTop=true
    b.StudsOffset=Vector3.new(0,3.5,0); b.Adornee=part; b.Parent=part
    local l=Instance.new("TextLabel"); l.Size=UDim2.new(1,0,1,0)
    l.BackgroundTransparency=1; l.Text=text; l.TextColor3=color
    l.TextStrokeTransparency=0; l.TextStrokeColor3=Color3.new(0,0,0)
    l.TextSize=14; l.Font=Enum.Font.GothamBold; l.Parent=b
end

local function RemESP(part,tag)
    if not part then return end
    local b=part:FindFirstChild(tag); if b then b:Destroy() end
end

local function MakeHL(model,tag,color)
    if not model or not model.Parent then return end
    if model:FindFirstChild(tag.."_HL") then return end
    local h=Instance.new("Highlight"); h.Name=tag.."_HL"
    h.Adornee=model; h.FillColor=color; h.OutlineColor=color
    h.FillTransparency=0.65; h.OutlineTransparency=0
    h.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop; h.Parent=model
end

local function RemHL(model,tag)
    if not model then return end
    local h=model:FindFirstChild(tag.."_HL"); if h then h:Destroy() end
end

local function ItemESP(model,tag,label,color)
    task.spawn(function()
        task.wait(0.15)
        if not model or not model.Parent then return end
        local part=GPP(model); if not part then return end
        if part:FindFirstChild(tag) then return end
        MakeESP(part,tag,label,color)
        MakeHL(model,tag,color)
        model.AncestryChanged:Connect(function()
            if not model.Parent then RemESP(part,tag); RemHL(model,tag) end
        end)
    end)
end

-- ── DOOR LOGIC ─────────────────────────────────────────
local function HandleDoor(door)
    task.spawn(function()
        task.wait(0.3)
        if not door.Parent then return end
        if door:FindFirstChild("dupeDoor") then return end
        local part=GPP(door); if not part then return end
        if part:FindFirstChild("DoorsESP") then return end
        MakeESP(part,"DoorsESP","✅ ПРАВИЛЬНАЯ",Color3.fromRGB(60,255,60))
        MakeHL(door,"DoorsESP",Color3.fromRGB(60,255,60))
        door.AncestryChanged:Connect(function()
            if not door.Parent then RemESP(part,"DoorsESP"); RemHL(door,"DoorsESP") end
        end)
    end)
end

