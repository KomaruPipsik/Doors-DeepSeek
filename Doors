local playerESPConnections = {}

local function UpdatePlayerESP()
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr == Player then continue end
		local char = plr.Character
		if not char then continue end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp then
			if playerESPEnabled then
				MakeESP(hrp, "PlayerESP", "👤 " .. plr.Name, Color3.fromRGB(100, 200, 255))
			else
				RemoveESP(hrp, "PlayerESP")
			end
		end
		-- Highlight
		local hl = char:FindFirstChildOfClass("SelectionBox") or (playerESPEnabled and Instance.new("SelectionBox") or nil)
		if hl and playerESPEnabled then
			hl.Name = "PlayerHL"
			hl.Adornee = char
			hl.Color3 = Color3.fromRGB(100, 200, 255)
			hl.LineThickness = 0.04
			hl.SurfaceTransparency = 0.8
			hl.SurfaceColor3 = Color3.fromRGB(100, 200, 255)
			hl.Parent = char
		elseif not playerESPEnabled then
			local existing = char:FindFirstChild("PlayerHL")
			if existing then existing:Destroy() end
		end
	end
end

