local lastPos  = Vector3.new()
local scanTick = 0

local xrayScanTick = 0

RunService.RenderStepped:Connect(function()
    -- FOV через RenderStepped — применяется после рендера, игра не перебивает
    Camera.FieldOfView = customFOV
