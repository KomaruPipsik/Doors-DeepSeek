-- Отслеживаем CurrentRooms
local currentRooms = Workspace:WaitForChild("CurrentRooms", 10)
local roomConnections = {}

local function HandleDescendant(desc, room)
	-- Двери
	if desc.Name == "Door" or desc.Name == "dupeDoor" then
		local isDupe = desc:FindFirstChild("dupeDoor") or desc.Name == "dupeDoor"
		local part = GetPrimaryPart(desc)
		if part then
			if doorsESPEnabled then
				local tag = isDupe and "ДУБЛЬ ДВЕРЬ" or "ПРАВИЛЬНАЯ ДВЕРЬ"
				local col = isDupe and Color3.fromRGB(255, 60, 60) or Color3.fromRGB(60, 255, 60)
				MakeESP(part, "DoorsESP", tag, col)
			end
			desc.AncestryChanged:Connect(function()
				if not desc.Parent then RemoveESP(part, "DoorsESP") end
			end)
		end
	end

	-- Ключ (KeyObtain прямо в Assets или внутри мебели)
	if desc.Name == "KeyObtain" then
		local part = GetPrimaryPart(desc) or desc
		if part and keyESPEnabled then
			MakeESP(part, "KeyESP", "🔑 КЛЮЧ", Color3.fromRGB(255, 230, 0))
		end
		desc.AncestryChanged:Connect(function()
			if not desc.Parent then RemoveESP(part, "KeyESP") end
		end)
	end

	-- Ключ из Dresser / DrawerContainer
	if desc.Name == "Dresser" or desc.Name == "DrawerContainer" then
		local kObt = desc:FindFirstChild("KeyObtain", true)
		if kObt then
			local hit = kObt:FindFirstChild("Hitbox") or kObt:FindFirstChild("KeyHitbox") or kObt
			local part = GetPrimaryPart(hit) or hit
			if part and keyESPEnabled then
				MakeESP(part, "KeyESP", "🔑 КЛЮЧ", Color3.fromRGB(255, 230, 0))
			end
			desc.AncestryChanged:Connect(function()
				if not desc.Parent then RemoveESP(part, "KeyESP") end
			end)
		end
	end

	-- Рычаг
	if desc.Name == "LeverForGate" and leverESPEnabled then
		local part = GetPrimaryPart(desc)
		if part then
			MakeESP(part, "LeverESP", "🔧 РЫЧАГ", Color3.fromRGB(255, 255, 0))
			desc.AncestryChanged:Connect(function()
				if not desc.Parent then RemoveESP(part, "LeverESP") end
			end)
		end
	end

	-- Книги (комн. 50)
	if desc.Name == "LiveHintBook" and booksESP then
		local part = GetPrimaryPart(desc) or desc
		MakeESP(part, "BookESP", "📖 КНИГА", Color3.fromRGB(0, 220, 255))
		desc.AncestryChanged:Connect(function()
			if not desc.Parent then RemoveESP(part, "BookESP") end
		end)
	end

	-- Crucifix (крест)
	if desc.Name == "CrucifixWall" and crucifixESP then
		local part = GetPrimaryPart(desc) or desc
		MakeESP(part, "CrucifixESP", "✝ КРЕСТ", Color3.fromRGB(255, 200, 50))
		desc.AncestryChanged:Connect(function()
			if not desc.Parent then RemoveESP(part, "CrucifixESP") end
		end)
	end

	-- Предметы в Rolltop_Desk (витамины и т.д., исключаем Lid)
	if desc.Name == "RolltopContainer" and itemsESP then
		for _, child in ipairs(desc:GetChildren()) do
			if child.Name ~= "Lid" then
				local part = GetPrimaryPart(child) or child
				if part then
					MakeESP(part, "ItemESP", "💊 " .. child.Name, Color3.fromRGB(180, 255, 100))
				end
			end
		end
		desc.ChildAdded:Connect(function(child)
			if child.Name ~= "Lid" and itemsESP then
				local part = GetPrimaryPart(child) or child
				if part then MakeESP(part, "ItemESP", "💊 " .. child.Name, Color3.fromRGB(180, 255, 100)) end
			end
		end)
	end

	-- Ловушки (90-99)
	if desc.Name == "Snare" and snareESP then
		local base = desc:FindFirstChild("SnareBase") or desc
		local part = GetPrimaryPart(base) or base
		MakeESP(part, "SnareESP", "⚠ ЛОВУШКА", Color3.fromRGB(255, 128, 0))
		desc.AncestryChanged:Connect(function()
			if not desc.Parent then RemoveESP(part, "SnareESP") end
		end)
	end

	-- Рычаги (100)
	if desc.Name == "LiveBreakerPolePickup" and polesESP then
		local part = GetPrimaryPart(desc) or desc
		MakeESP(part, "PoleESP", "⚡ РЫЧАГ 100", Color3.fromRGB(60, 255, 60))
		desc.AncestryChanged:Connect(function()
			if not desc.Parent then RemoveESP(part, "PoleESP") end
		end)
	end
end

-- Refresh-функции (вызываются при включении Toggle)
function refreshDoorsESP()
	if not currentRooms then return end
	for _, room in ipairs(currentRooms:GetChildren()) do
		for _, desc in ipairs(room:GetDescendants()) do
			if desc.Name == "Door" or desc.Name == "dupeDoor" then
				local isDupe = desc.Name == "dupeDoor" or desc:FindFirstChild("dupeDoor")
				local part = GetPrimaryPart(desc)
				if part then
					if doorsESPEnabled then
						local tag = isDupe and "ДУБЛЬ ДВЕРЬ" or "ПРАВИЛЬНАЯ ДВЕРЬ"
						local col = isDupe and Color3.fromRGB(255,60,60) or Color3.fromRGB(60,255,60)
						MakeESP(part, "DoorsESP", tag, col)
					else
						RemoveESP(part, "DoorsESP")
					end
				end
			end
		end
	end
end

function refreshKeysESP()
	if not currentRooms then return end
	for _, room in ipairs(currentRooms:GetChildren()) do
		for _, desc in ipairs(room:GetDescendants()) do
			if desc.Name == "KeyObtain" then
				local part = GetPrimaryPart(desc) or desc
				if keyESPEnabled then MakeESP(part, "KeyESP", "🔑 КЛЮЧ", Color3.fromRGB(255,230,0))
				else RemoveESP(part, "KeyESP") end
			end
		end
