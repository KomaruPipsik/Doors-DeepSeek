-- ══════════════════════════════════════════════
local dronesStampedeNotif = true -- глобальный флаг уведомления

local function MakePoolMarker(pool)
    if not pool or not pool:IsA("BasePart") then return end
    if pool:FindFirstChild("_PoolMarker") then return end

    -- Размер маркера = размер пула по X и Z, высота 2
    local size = pool.Size
    local marker = Instance.new("Part")
    marker.Name = "_PoolMarker"
    marker.Size = Vector3.new(size.X, 2, size.Z)
    marker.Anchored = true
    marker.CanCollide = false
    marker.CastShadow = false
    marker.Transparency = 0.4
    marker.BrickColor = BrickColor.new("Bright blue")
    marker.Material = Enum.Material.Neon
    -- Позиция: над пулом на 1 блок (чтобы маркер был прямо над водой)
    marker.CFrame = CFrame.new(pool.Position + Vector3.new(0, size.Y/2 + 1, 0))
    marker.Parent = Workspace
    table.insert(waterPoolParts, marker)

    -- Надпись над маркером
    local bill = Instance.new("BillboardGui")
    bill.Size = UDim2.new(0,120,0,30)
    bill.AlwaysOnTop = true
    bill.StudsOffset = Vector3.new(0,2,0)
    bill.Adornee = marker
    bill.Parent = marker
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,0,1,0)
    lbl.BackgroundTransparency = 1
    lbl.Text = "💧 " .. pool.Name
    lbl.TextColor3 = Color3.fromRGB(100,220,255)
    lbl.TextStrokeTransparency = 0
    lbl.TextSize = 13
    lbl.Font = Enum.Font.GothamBold
    lbl.Parent = bill

    -- Убираем маркер если пул исчезает
    pool.AncestryChanged:Connect(function()
        if not pool.Parent then
            pcall(function() marker:Destroy() end)
        end
    end)
end

local function HandleWater(waterModel)
    if not waterPoolEnabled then return end
    -- Pool1 .. Pool10
    for i = 1, 10 do
        local pool = waterModel:FindFirstChild("Pool"..i)
        if pool and pool:IsA("BasePart") then
            MakePoolMarker(pool)
        end
    end
    -- Следим за новыми пулами
    waterModel.ChildAdded:Connect(function(child)
        if not waterPoolEnabled then return end
        if child.Name:match("^Pool%d+$") and child:IsA("BasePart") then
            MakePoolMarker(child)
        end
    end)
end

function ScanWaterPools()
    if not currentRooms then return end
    for _, room in ipairs(currentRooms:GetChildren()) do
        local assets = room:FindFirstChild("Assets")
        if assets then
            for _, obj in ipairs(assets:GetChildren()) do
                if obj.Name == "Water" then HandleWater(obj) end
            end
        end
        local water = room:FindFirstChild("Water")
        if water then HandleWater(water) end
    end
end

