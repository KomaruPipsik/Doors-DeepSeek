--// MAIN ENGINE TICK LOOP //--
local notifiedRush = {}

RunService.RenderStepped:Connect(function()
	local currentRooms = Workspace:FindFirstChild("CurrentRooms")
	
	-- Doors & Room-based Items Loop
	if currentRooms then
		for _, room in ipairs(currentRooms:GetChildren()) do
			-- 1. Doors ESP (Correct & Dupe)
			if doorsESPEnabled then
				local door = room:FindFirstChild("Door", true)
				if door then
					local isDupe = door:FindFirstChild("dupeDoor") or door.Name == "dupeDoor"
					if isDupe then
						CreateOrUpdateESP(door, "DoorsESP", "DUPE DOOR", Color3.fromRGB(255, 0, 0))
					else
						CreateOrUpdateESP(door, "DoorsESP", "CORRECT DOOR", Color3.fromRGB(0, 255, 0))
					end
				end
			end
			
			-- 5. Lever For Gate ESP
			if leverESPEnabled then
				local assets = room:FindFirstChild("Assets")
				if assets then
					for _, item in ipairs(assets:GetDescendants()) do
						if item.Name == "LeverForGate" then
							CreateOrUpdateESP(item, "LeverESP", "LEVER", Color3.fromRGB(255, 255, 0))
						end
					end
				end
			end
			
			-- 4. Key ESP
			if keyESPEnabled then
				local assets = room:FindFirstChild("Assets")
				if assets then
					for _, dresser in ipairs(assets:GetDescendants()) do
						if dresser.Name == "Dresser" or dresser.Name == "DrawerContainer" then
							local keyObtain = dresser:FindFirstChild("KeyObtain", true)
							if keyObtain then
								local hit = keyObtain:FindFirstChild("Hitbox") or keyObtain:FindFirstChild("KeyHitbox") or keyObtain
								CreateOrUpdateESP(hit, "KeyESP", "KEY", Color3.fromRGB(255, 255, 0))
							end
						end
					end
				end
			end
			
			-- 9. Room 50 Books ESP
			if booksESP then
				local assets = room:FindFirstChild("Assets")
				if assets then
					for _, shelf in ipairs(assets:GetDescendants()) do
						if shelf.Name == "Modular_Bookshelf" then
							local liveBook = shelf:FindFirstChild("LiveHintBook", true)
							if liveBook then
								CreateOrUpdateESP(liveBook, "BookESP", "BOOK", Color3.fromRGB(0, 255, 255))
							end
						end
					end
				end
			end
			
			-- 11. Snares ESP (90-99)
			if snareESP then
				local assets = room:FindFirstChild("Assets")
				if assets then
					for _, snareModel in ipairs(assets:GetDescendants()) do
						if snareModel.Name == "Snare" then
							local base = snareModel:FindFirstChild("SnareBase") or snareModel
							CreateOrUpdateESP(base, "SnareESP", "TRAP", Color3.fromRGB(255, 128, 0))
						end
					end
				end
			end
			
			-- 12. Room 100 Breaker Poles ESP
			if polesESP then
				for _, pole in ipairs(room:GetDescendants()) do
					if pole.Name == "LiveBreakerPolePickup" then
						CreateOrUpdateESP(pole, "PoleESP", "LEVER", Color3.fromRGB(0, 255, 0))
					end
				end
			end
			
			-- 8. Figure ESP & Avoidance
			local rig = room:FindFirstChild("FigureRig", true) or room:FindFirstChild("FigureSetup", true)
			if rig then
				local primaryPart = rig:FindFirstChild("HumanoidRootPart") or rig:FindFirstChildWhichIsA("BasePart")
				if primaryPart then
					if figureESP then
						CreateOrUpdateESP(primaryPart, "FigureESP", "FIGURE", Color3.fromRGB(255, 0, 0))
					end
					if figureAvoid and Humanoid and HumanoidRootPart then
						local dist = (HumanoidRootPart.Position - primaryPart.Position).Magnitude
						if dist < avoidRadius then
							local dir = (HumanoidRootPart.Position - primaryPart.Position).Unit
							Humanoid:Move(dir * 2)
						end
					end
				end
			end
		end
	end
	
	-- 2. Rush & Ambush ESP + Notifications (Global Workspace scan)
	for _, obj in ipairs(Workspace:GetChildren()) do
		if obj.Name == "RushMoving" or obj.Name == "AmbushMoving" then
			if rushNotifications and not notifiedRush[obj] then
				notifiedRush[obj] = true
				SendNotification("WARNING!", obj.Name .. " is incoming!")
			end
			if rushAmbushESP then
				CreateOrUpdateESP(obj, "RushAmbushESP", obj.Name:upper(), Color3.fromRGB(255, 50, 50))
			end
		end
		
		-- 7. Eyes ESP & Anti-Damage
		if obj.Name == "Eyes" then
			if eyesESP then
				CreateOrUpdateESP(obj, "EyesESP", "EYES", Color3.fromRGB(150, 0, 255))
			end
			if eyesAntiDamage and HumanoidRootPart then
				local direct = obj:FindFirstChild("Hitbox") or obj:FindFirstChildWhichIsA("BasePart")
				if direct then
					Camera.CFrame = CFrame.new(Camera.CFrame.Position, Vector3.new(Camera.CFrame.Position.X, Camera.CFrame.Position.Y - 10, Camera.CFrame.Position.Z + 10))
				end
			end
		end
	end
	
	-- 8. Screech Global Handler
	for _, entityName in ipairs({"Screech", "ScreechRetro", "ScreechRushMode"}) do
		local screech = Workspace:FindFirstChild(entityName, true)
		if screech then
			if screechNotif and not screech:GetAttribute("Notified") then
				screech:SetAttribute("Notified", true)
				SendNotification("SCREECH!", "Screech has appeared!")
			end
			if screechAutoTurn then
				local part = screech:FindFirstChild("HumanoidRootPart") or screech:FindFirstChildWhichIsA("BasePart")
				if part then
					Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
				end
			end
		end
	end
end)

-- 6. Speed & Anti-Teleport Loop
local lastPosition = Vector3.new()
RunService.Stepped:Connect(function()
	if speedEnabled and Humanoid and HumanoidRootPart then
		Humanoid.WalkSpeed = customSpeed
		if antiTpEnabled then
			if (HumanoidRootPart.Position - lastPosition).Magnitude > 50 and not Workspace:GetAttribute("InElevator") then
				HumanoidRootPart.CFrame = CFrame.new(lastPosition)
			else
				lastPosition = HumanoidRootPart.Position
			end
		else
			lastPosition = HumanoidRootPart.Position
		end
	end
end)

