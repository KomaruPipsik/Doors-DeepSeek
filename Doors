end

local function Tog(page,name,cb)
    local b=Instance.new("TextButton"); b.Size=UDim2.new(1,0,0,32)
    b.BackgroundColor3=BTN_OFF; b.Text="  ○  "..name
    b.TextColor3=Color3.fromRGB(200,80,80); b.TextSize=12; b.Font=Enum.Font.GothamSemibold
    b.TextXAlignment=Enum.TextXAlignment.Left; b.AutoButtonColor=false; b.Parent=page
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,6)
    local st=false
    b.MouseButton1Click:Connect(function()
        st=not st
        b.Text=(st and "  ●  " or "  ○  ")..name
        b.TextColor3=st and Color3.fromRGB(80,220,100) or Color3.fromRGB(200,80,80)
        b.BackgroundColor3=st and BTN_ON or BTN_OFF
        cb(st)
    end)
    return b
end

local function Sld(page,name,mn,mx,def,cb)
    local con=Instance.new("Frame"); con.Size=UDim2.new(1,0,0,50)
    con.BackgroundColor3=BTN_OFF; con.Parent=page
    Instance.new("UICorner",con).CornerRadius=UDim.new(0,6)
    local l=Instance.new("TextLabel"); l.Size=UDim2.new(1,-8,0,22); l.Position=UDim2.new(0,8,0,2)
    l.BackgroundTransparency=1; l.Text=name..": "..def; l.TextColor3=Color3.fromRGB(210,210,210)
    l.TextSize=12; l.Font=Enum.Font.GothamSemibold; l.TextXAlignment=Enum.TextXAlignment.Left; l.Parent=con
    local bar=Instance.new("TextButton"); bar.Size=UDim2.new(0.92,0,0,9); bar.Position=UDim2.new(0.04,0,0,34)
    bar.BackgroundColor3=Color3.fromRGB(50,50,65); bar.Text=""; bar.Parent=con
    Instance.new("UICorner",bar).CornerRadius=UDim.new(0,4)
    local fill=Instance.new("Frame"); fill.Size=UDim2.new((def-mn)/(mx-mn),0,1,0)
    fill.BackgroundColor3=Color3.fromRGB(55,100,230); fill.BorderSizePixel=0; fill.Parent=bar
    Instance.new("UICorner",fill).CornerRadius=UDim.new(0,4)
    local dr=false
    bar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dr=true end end)
    UIS.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then dr=false end end)
    UIS.InputChanged:Connect(function(i)
        if dr and i.UserInputType==Enum.UserInputType.MouseMovement then
            local pct=math.clamp((UIS:GetMouseLocation().X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
            fill.Size=UDim2.new(pct,0,1,0)
            local v=math.floor(mn+(mx-mn)*pct); l.Text=name..": "..v; cb(v)
        end
    end)
end

local function Btn(page,text,col,tcol,cb)
    local b=Instance.new("TextButton"); b.Size=UDim2.new(1,0,0,32)
    b.BackgroundColor3=col; b.Text="  "..text; b.TextColor3=tcol
    b.TextSize=12; b.Font=Enum.Font.GothamBold
    b.TextXAlignment=Enum.TextXAlignment.Left; b.AutoButtonColor=false; b.Parent=page
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,6)
    b.MouseButton1Click:Connect(cb); return b
end

