RunService.Heartbeat:Connect(function(dt)
    if speedEnabled and Humanoid then Humanoid.WalkSpeed=customSpeed end

    scanTick=scanTick+dt
    if scanTick<0.1 then return end
    scanTick=0

    local ws=Workspace:GetChildren()
    local rushFound=false
    local ambushFound=false

    for _, obj in ipairs(ws) do
        local isRush   = obj.Name=="RushMoving"
        local isAmbush = obj.Name=="AmbushMoving"

        if isRush or isAmbush then
            -- Только ESP надпись (движение обрабатывается через ChildAdded)
            if rushAmbushESP then
                local part=GetPrimaryPart(obj)
                if part then MakeESP(part,"RushAmbushESP",isRush and "💨 РАШ" or "🌀 АМБУШ",Color3.fromRGB(255,60,60)) end
            end
        end

        -- Eyes
        if obj.Name=="Eyes" then
            if eyesESP then
                local part=GetPrimaryPart(obj)
                if part then MakeESP(part,"EyesESP","👁 EYES",Color3.fromRGB(180,0,255)) end
            end
            if eyesAntiDmg and HumanoidRootPart then
                local part=GetPrimaryPart(obj)
                if part then
                    Camera.CameraType = Enum.CameraType.Scriptable
                    local away = (HumanoidRootPart.Position - part.Position).Unit
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + away)
                end
            end
        end

        -- Alma — анти-взгляд (как Eyes)
        if obj.Name=="Alma" and almaAntiLook and HumanoidRootPart then
            local part = GetPrimaryPart(obj)
            if part then
                Camera.CameraType = Enum.CameraType.Scriptable
                local away = (HumanoidRootPart.Position - part.Position).Unit
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + away)
            end
        end
    end

    -- Если Eyes и Alma исчезли — возвращаем камеру
    if (eyesAntiDmg or almaAntiLook) and Camera.CameraType == Enum.CameraType.Scriptable then
        local blockCam = false
        for _, obj in ipairs(ws) do
            if (obj.Name=="Eyes" and eyesAntiDmg) or (obj.Name=="Alma" and almaAntiLook) then
                blockCam = true; break
            end
        end
        if not blockCam then
            Camera.CameraType = Enum.CameraType.Custom
        end
    end

    -- X-Ray — раз в 2 сек сканируем новые объекты
    if xrayEnabled then
        if not xrayScanTick then xrayScanTick = 0 end
        xrayScanTick = xrayScanTick + dt
        if xrayScanTick > 2 then
            xrayScanTick = 0
            if currentRooms then
                for _, room in ipairs(currentRooms:GetChildren()) do
                    for _, part in ipairs(room:GetDescendants()) do
                        if part:IsA("BasePart") and not part:FindFirstChild("_XRayHL") then
                            ApplyXRay(part)
                        end
                    end
                end
            end
        end
    end

    -- Screech
    if screechTurn and activeSreech then
        local part=activeSreech:FindFirstChild("HumanoidRootPart") or activeSreech:FindFirstChildWhichIsA("BasePart")
        if part then Camera.CFrame=CFrame.new(Camera.CFrame.Position,part.Position) end
    end

    -- Figure
    if currentRooms then
        for _, room in ipairs(currentRooms:GetChildren()) do
            local rig=room:FindFirstChild("FigureRig",true) or room:FindFirstChild("FigureSetup",true)
            if rig then
                local pp=rig:FindFirstChild("HumanoidRootPart") or rig:FindFirstChildWhichIsA("BasePart")
                if pp then
                    if figureESP then MakeESP(pp,"FigureESP","👹 FIGURE",Color3.fromRGB(255,0,0)) end
                    if figureAvoid and HumanoidRootPart then
                        local dist=(HumanoidRootPart.Position-pp.Position).Magnitude
                        if dist<avoidRadius then
                            local dir=(HumanoidRootPart.Position-pp.Position).Unit
                            HumanoidRootPart.CFrame=HumanoidRootPart.CFrame+dir*2
                        end
                    end
                end
            end
        end
    end

    -- Игроки ESP
    if playerESPEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do SetPlayerESP(plr,true) end
    end
end)

