--// ROOM CACHING SYSTEM (No Lag ESP)
local roomItemsCache = {}

local function CacheRoom(room)
	if roomItemsCache[room] then return end
	local data = { Books = {}, Keys = {}, Items = {}, Doors = {}, Snares = {}, Poles = {}, Levers = {} }
	
	local door = room:FindFirstChild("Door", true)
	if door then table.insert(data.Doors, door) end
	
	for _, desc in ipairs(room:GetDescendants()) do
		if desc.Name == "LiveHintBook" then 
			table.insert(data.Books, desc)
		elseif desc.Name == "KeyObtain" or desc.Name == "KeyHitbox" then 
			table.insert(data.Keys, desc)
		elseif desc.Name == "CrucifixWall" or desc.Name == "Vitamins" then 
			table.insert(data.Items, desc)
		elseif desc.Name == "LeverForGate" then
			table.insert(data.Levers, desc)
		elseif desc.Name == "Snare" then
			table.insert(data.Snares, desc:FindFirstChild("SnareBase") or desc)
		elseif desc.Name == "LiveBreakerPolePickup" then
			table.insert(data.Poles, desc)
		end
	end
	roomItemsCache[room] = data
end

--// MAIN ENGINE LOOP
local notifiedRush = {}
local hidingActive = false
local hideTimeout = 0
local wasAutoSeeking = false
local preEvadeCFrame = nil
local evadeActive = false

RunService.RenderStepped:Connect(function()
	local currentRooms = Workspace:FindFirstChild("CurrentRooms")
	
	-- Check Active Dangers for Eyes Logic
	local dangerActive = false
	for _, obj in ipairs(Workspace:GetChildren()) do
		if obj.Name == "RushMoving" or obj.Name == "AmbushMoving" or obj.Name == "Eyes" then
			dangerActive = true
			break
		end
	end
	for _, name in ipairs({"Screech", "ScreechRetro", "ScreechRushMode"}) do
		if Workspace:FindFirstChild(name, true) then dangerActive = true break end
	end

	-- Players ESP
	if playersESP then
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= Player and p.Character then
				CreateOrUpdateESP(p.Character, "PlayerESP", p.Name, Color3.fromRGB(0, 170, 255))
			end
		end
	end

	-- Room Loop (ESP + Avoidance + Hiding)
	if currentRooms then
		for _, room in ipairs(currentRooms:GetChildren()) do
			CacheRoom(room)
			
			-- Figure Logic
			local rig = room:FindFirstChild("FigureRig", true) or room:FindFirstChild("FigureSetup", true)
			if rig then
				local primaryPart = rig:FindFirstChild("HumanoidRootPart") or rig:FindFirstChildWhichIsA("BasePart")
				if primaryPart then
					if figureESP then CreateOrUpdateESP(primaryPart, "FigureESP", "FIGURE", Color3.fromRGB(255, 0, 0)) end
					if figureAvoid and Humanoid and HumanoidRootPart then
						local dist = (HumanoidRootPart.Position - primaryPart.Position).Magnitude
						if dist < avoidRadius then
							local raycastParams = RaycastParams.new()
							raycastParams.FilterType = RaycastFilterType.Exclude
							raycastParams.FilterDescendantsInstances = {Character}
							local hitForward = Workspace:Raycast(HumanoidRootPart.Position, HumanoidRootPart.CFrame.LookVector * 4, raycastParams)
							if hitForward or Humanoid.MoveDirection.Magnitude < 0.1 then
								Humanoid.Jump = true
							else
								local dir = (HumanoidRootPart.Position - primaryPart.Position).Unit
								Humanoid:Move(dir * 2)
							end
						end
					end
				end
			end
			
			-- Auto-Hiding in Wardrobe
			if autoHiding and HumanoidRootPart then
				local rushObj = Workspace:FindFirstChild("RushMoving") or Workspace:FindFirstChild("AmbushMoving")
				local assets = room:FindFirstChild("Assets")
				if rushObj then
					local rushPart = rushObj:FindFirstChildWhichIsA("BasePart")
					if rushPart then
						local distanceToRush = (HumanoidRootPart.Position - rushPart.Position).Magnitude
						if distanceToRush <= 75 and assets then
							for _, wardrobe in ipairs(assets:GetDescendants()) do
								if wardrobe.Name == "Wardrobe" then
									local prompt = wardrobe:FindFirstChildOfClass("ProximityPrompt") or wardrobe:FindFirstChild("Prompt", true)
									if prompt and not hidingActive then
										Camera.CFrame = CFrame.new(Camera.CFrame.Position, wardrobe:GetPivot().Position)
										task.spawn(function()
											hidingActive = true
											fireproximityprompt(prompt)
										end)
										break
									end
								end
							end
						elseif distanceToRush > 75 and hidingActive then
							if hideTimeout == 0 then
								hideTimeout = tick()
							elseif tick() - hideTimeout >= 2 then
								VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.W, false, game)
								task.wait(0.1)
								VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.W, false, game)
								hidingActive = false
								hideTimeout = 0
							end
						else
							hideTimeout = 0
						end
					end
				end
			end
		end

		-- Render Cached ESP
		for room, data in pairs(roomItemsCache) do
			if not room.Parent then roomItemsCache[room] = nil continue end
			if doorsESPEnabled then
				for _, door in ipairs(data.Doors) do
					local isDupe = door:FindFirstChild("dupeDoor") or door.Name == "dupeDoor"
					CreateOrUpdateESP(door, "DoorsESP", isDupe and "DUPE" or "CORRECT DOOR", isDupe and Color3.fromRGB(255,0,0) or Color3.fromRGB(0,255,0))
				end
			end
			if keyESPEnabled then for _, key in ipairs(data.Keys) do CreateOrUpdateESP(key, "KeyESP", "KEY", Color3.fromRGB(255, 255, 0)) end end
			if itemsESPEnabled then for _, item in ipairs(data.Items) do CreateOrUpdateESP(item, "ItemsESP", item.Name:upper(), Color3.fromRGB(255, 170, 0)) end end
			if booksESP then for _, book in ipairs(data.Books) do CreateOrUpdateESP(book, "BookESP", "BOOK", Color3.fromRGB(0, 255, 255)) end end
			if leverESPEnabled then for _, lever in ipairs(data.Levers) do CreateOrUpdateESP(lever, "LeverESP", "LEVER", Color3.fromRGB(255, 255, 0)) end end
			if snareESP then for _, snare in ipairs(data.Snares) do CreateOrUpdateESP(snare, "SnareESP", "TRAP", Color3.fromRGB(255, 128, 0)) end end
			if polesESP then for _, pole in ipairs(data.Poles) do CreateOrUpdateESP(pole, "PoleESP", "LEVER", Color3.fromRGB(0, 255, 0)) end end
		end
	end

	-- Global Entities (Rush, Ambush, Eyes, Screech)
	local rush = Workspace:FindFirstChild("RushMoving")
	local ambush = Workspace:FindFirstChild("AmbushMoving")

	for _, obj in ipairs(Workspace:GetChildren()) do
		if obj.Name == "RushMoving" or obj.Name == "AmbushMoving" then
			if rushNotifications and not notifiedRush[obj] then
				notifiedRush[obj] = true
				SendNotification("WARNING!", obj.Name .. " is incoming!")
			end
			if rushAmbushESP then CreateOrUpdateESP(obj, "RushAmbushESP", obj.Name:upper(), Color3.fromRGB(255, 50, 50)) end
		end
		
		if obj.Name == "Eyes" then
			if eyesESP then CreateOrUpdateESP(obj, "EyesESP", "EYES", Color3.fromRGB(150, 0, 255)) end
			if eyesAntiDamage and not dangerActive and HumanoidRootPart then
				Camera.CFrame = CFrame.new(Camera.CFrame.Position, Vector3.new(Camera.CFrame.Position.X, Camera.CFrame.Position.Y - 10, Camera.CFrame.Position.Z + 10))
			end
		end
	end

	for _, entityName in ipairs({"Screech", "ScreechRetro", "ScreechRushMode"}) do
		local screech = Workspace:FindFirstChild(entityName, true)
		if screech then
			if screechNotif and not screech:GetAttribute("Notified") then
				screech:SetAttribute("Notified", true)
				SendNotification("SCREECH!", "Screech has appeared!")
			end
			if screechAutoTurn then
				local part = screech:FindFirstChild("HumanoidRootPart") or screech:FindFirstChildWhichIsA("BasePart")
				if part then Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position) end
			end
		end
	end

	-- Rush/Ambush TP Evade
	if roofFloorEvade and HumanoidRootPart then
		if rush or ambush then
			if not evadeActive then
				evadeActive = true
				preEvadeCFrame = HumanoidRootPart.CFrame
				HumanoidRootPart.Anchored = true
			end
			HumanoidRootPart.CFrame = preEvadeCFrame * CFrame.new(0, rush and 25 or -20, 0)
		elseif evadeActive then
			evadeActive = false
			HumanoidRootPart.Anchored = false
			if preEvadeCFrame then HumanoidRootPart.CFrame = preEvadeCFrame end
		end
	end

	-- Seek Auto-Run
	local seek = Workspace:FindFirstChild("SeekMovingNewClone")
	if autoSeekRun and seek and HumanoidRootPart then
		wasAutoSeeking = true
		local targetDoor
		local maxRoom = -1
		
		if currentRooms then
			for _, r in ipairs(currentRooms:GetChildren()) do
				local num = tonumber(r.Name)
				if num and num > maxRoom then
					local d = r:FindFirstChild("Door", true)
					if d then maxRoom = num; targetDoor = d end
				end
			end
		end
		
		if targetDoor then
			local doorPos = targetDoor:GetPivot().Position
			local myPos = HumanoidRootPart.Position
			local dist = (Vector3.new(myPos.X, 0, myPos.Z) - Vector3.new(doorPos.X, 0, doorPos.Z)).Magnitude
			
			if dist > 8 then
				HumanoidRootPart.Anchored = true
				local dir = (Vector3.new(doorPos.X, 0, doorPos.Z) - Vector3.new(myPos.X, 0, myPos.Z)).Unit
				HumanoidRootPart.CFrame = CFrame.new(myPos + (dir * 2)) * CFrame.new(0, (doorPos.Y - 15) - myPos.Y, 0)
			else
				HumanoidRootPart.Anchored = true
				HumanoidRootPart.CFrame = targetDoor:GetPivot()
				local prompt = targetDoor:FindFirstChildWhichIsA("ProximityPrompt", true)
				if prompt then fireproximityprompt(prompt) end
			end
		end
	elseif wasAutoSeeking then
		wasAutoSeeking = false
		if HumanoidRootPart then HumanoidRootPart.Anchored = false end
	end
end)

