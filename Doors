--  SMOOTH MOVE helpers
-- ══════════════════════════════════════════════
-- Плавный сдвиг по Y за MOVE_DUR секунд
local rushMoveConn    = nil
local ambushMoveConn  = nil

local function SmoothY(fromY, toY, duration, onStep, onDone)
    local t0 = tick()
    local conn
    conn = RunService.Heartbeat:Connect(function()
        if not HumanoidRootPart then conn:Disconnect() return end
        local pct = math.clamp((tick()-t0)/duration, 0, 1)
        local ease = pct*pct*(3-2*pct)
        local y = fromY + (toY-fromY)*ease
        onStep(y)
        if pct >= 1 then conn:Disconnect(); if onDone then onDone() end end
    end)
    return conn
end

