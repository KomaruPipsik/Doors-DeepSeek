local RoomService = {}
function RoomService.ScanRoom(room)
    if not room or not room:IsA("Model") then return end
    local assets = room:FindFirstChild("Assets")
    if not assets then return end

    for _, door in ipairs(room:GetChildren()) do
        if door.Name == "Door" or door.Name == "Light" then
            local dupe = door:FindFirstChild("door") or door:FindFirstChild("DupeDoor")
            if dupe and door:GetAttribute("Hidden") == true then
                Utils.CreateESP(door, Config.ESPColors.DupeDoor, "DupeDoor")
            end
        end
    end

    local dresser = assets:FindFirstChild("Dresser")
    if dresser then
        for _, desc in ipairs(dresser:GetDescendants()) do
            if desc.Name == "KeyObtain" or desc.Name == "KeyObtaln" then
                local hitbox = Utils.FindAnyChild(desc, {"Hitbox", "Hltbox"})
                if hitbox then
                    local keyPart = Utils.FindAnyChild(hitbox, {"KeyHitbox", "KeyNitbox"})
                    if keyPart then Utils.CreateESP(keyPart, Config.ESPColors.Key, "Key") end
                end
            end
        end
    end

    local snare = assets:FindFirstChild("Snare")
    if snare then
        for _, desc in ipairs(snare:GetDescendants()) do
            if desc.Name == "SnareBase" and desc:IsA("BasePart") then
                Utils.CreateESP(desc, Config.ESPColors.Snare, "Snare")
            end
        end
    end

    for _, desc in ipairs(room:GetDescendants()) do
        if desc.Name == "LiveBreakerPolePickup" or desc.Name == "LiveBreakerPolePlckup" then
            Utils.CreateESP(desc, Config.ESPColors.Breaker, "Breaker")
        end
    end

    local bookshelves = Utils.FindAnyChild(assets, {"Bookshelves", "Bookshelvesl"})
    if bookshelves then
        for _, desc in ipairs(bookshelves:GetDescendants()) do
            if desc.Name == "LiveHintBook" then
                Utils.CreateESP(desc, Config.ESPColors.Book, "Book")
            end
        end
    end

    local figureSetup = Utils.FindAnyChild(room, {"FigureSetup", "FlgureSetup"})
    if figureSetup then
        local figureRig = figureSetup:FindFirstChild("FigureRig")
        if figureRig then
            Utils.CreateESP(figureRig, Config.ESPColors.Figure, "Figure")
        end
    end
end

function RoomService.Initialize()
    local currentRooms = Workspace:WaitForChild("CurrentRooms", 10)
    if currentRooms then
        for _, room in ipairs(currentRooms:GetChildren()) do
            task.spawn(RoomService.ScanRoom, room)
        end
        currentRooms.ChildAdded:Connect(function(room)
            task.wait(0.5)
            task.spawn(RoomService.ScanRoom, room)
        end)
    end
end

local EntityService = {}
function EntityService.HandleCameraAversion(eyesModel)
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not Config.Toggles.EntityWarnings then return end
        if not eyesModel or not eyesModel.Parent then 
            connection:Disconnect() 
            return 
        end
        
        local core = eyesModel:FindFirstChild("Core") or eyesModel.PrimaryPart
        if not core then return end

        local camCFrame = Camera.CFrame
        local lookVector = camCFrame.LookVector
        local directionToEyes = (core.Position - camCFrame.Position).Unit
        
        if lookVector:Dot(directionToEyes) > 0.45 then
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(camCFrame.Position, camCFrame.Position + Vector3.new(lookVector.X, -1, lookVector.Z)), 0.2)
        end
    end)
end

function EntityService.HandleScreech(screech)
    if not Config.Toggles.EntityWarnings then return end
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not screech or not screech.Parent then connection:Disconnect(); return end
        local root = screech:FindFirstChild("HumanoidRootPart") or screech.PrimaryPart
        if root then
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, root.Position)
        end
    end)
end

function EntityService.Initialize()
    Workspace.ChildAdded:Connect(function(child)
        if not Config.Toggles.EntityWarnings then return end
        if child.Name == "RushMoving" or child.Name == "AmbushMoving" then
            Utils.Notify("ВНИМАНИЕ", child.Name .. " приближается!")
        elseif child.Name == "Eyes" then
            EntityService.HandleCameraAversion(child)
        elseif child.Name == "Screech" or child.Name == "ScreechRetro" or child.Name == "ScreechRushMode" then
            EntityService.HandleScreech(child)
        end
    end)
end

local PlayerService = {}
function PlayerService.SetupAntiRubberband()
    RunService.Heartbeat:Connect(function(deltaTime)
        if not Config.Toggles.AntiRubberband then return end
        local character = LocalPlayer.Character
        if not character then return end
        
        local humanoid = character:FindFirstChild("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        
        if humanoid and rootPart and humanoid.Health > 0 and humanoid.MoveDirection.Magnitude > 0 then
            local speedDiff = Config.CustomWalkSpeed - humanoid.WalkSpeed
            if speedDiff > 0 then
                rootPart.CFrame = rootPart.CFrame + (humanoid.MoveDirection * (speedDiff * deltaTime))
            end
        end
    end)
end

function PlayerService.SetupFullBright()
    RunService.RenderStepped:Connect(function()
        if not Config.Toggles.FullBright then return end
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.ColorShift_Bottom = Color3.new(1, 1, 1)
        Lighting.ColorShift_Top = Color3.new(1, 1, 1)
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
    end)
end

function PlayerService.SetupFPSBooster()
    local function optimizeInstance(instance)
        if not Config.Toggles.FPSBooster then return end
        pcall(function()
            if instance:IsA("BasePart") and not instance:IsA("MeshPart") then
                instance.Material = Enum.Material.SmoothPlastic
                instance.Reflectance = 0
                instance.CastShadow = false
            elseif instance:IsA("Decal") or instance:IsA("Texture") then
                instance.Transparency = 1 
            elseif instance:IsA("ParticleEmitter") or instance:IsA("Trail") then
                instance.Enabled = false
            end
        end)
    end
    Workspace.DescendantAdded:Connect(optimizeInstance)
end

