--  SAFE PLATFORM
-- ══════════════════════════════════════════════
local function CreatePlatform()
    if safePlatform then return end
    local p=Instance.new("Part")
    p.Name="_SafePlatform"; p.Size=Vector3.new(8,0.4,8)
    p.Anchored=true; p.CanCollide=true
    p.Transparency=0.45; p.BrickColor=BrickColor.new("Bright blue")
    p.Material=Enum.Material.SmoothPlastic; p.Parent=Workspace
    safePlatform=p
end
local function RemovePlatform()
    if safePlatform then safePlatform:Destroy(); safePlatform=nil end
end
local function UpdatePlatform()
    if safePlatform and HumanoidRootPart then
        local pos=HumanoidRootPart.Position
        safePlatform.CFrame=CFrame.new(pos.X, pos.Y-3.2, pos.Z)
    end
end

-- ══════════════════════════════════════════════
--  SMOOTH Y MOVE
--  bypassAntiTp=true во время движения → анти-тп не мешает
-- ══════════════════════════════════════════════
local function SmoothY(fromY, toY, duration, onStep, onDone)
    local t0=tick()
    bypassAntiTp=true
    local conn
    conn=RunService.Heartbeat:Connect(function()
        if not HumanoidRootPart then conn:Disconnect(); bypassAntiTp=false; return end
        local pct=math.clamp((tick()-t0)/duration,0,1)
        local ease=pct*pct*(3-2*pct)
        onStep(fromY+(toY-fromY)*ease)
        UpdatePlatform()
        if pct>=1 then
            conn:Disconnect()
            -- НЕ сбрасываем bypassAntiTp здесь — он сбросится когда Rush/Ambush исчезнет
            if onDone then onDone() end
        end
    end)
end

-- ══════════════════════════════════════════════
--  RUSH / AMBUSH — мгновенное обнаружение через событие
-- ══════════════════════════════════════════════
local function StartRush(obj)
    if rushNotif and not notifiedRush[obj] then
        notifiedRush[obj]=true
        SendNotif("⚠ ВНИМАНИЕ!","РАШ летит!")
    end
    if rushUpEnabled and HumanoidRootPart and not rushActive then
        rushActive=true
        rushSavedY=HumanoidRootPart.Position.Y
        CreatePlatform()
        SmoothY(rushSavedY, rushSavedY+OFFSET_Y, MOVE_DUR, function(y)
            if HumanoidRootPart then
                local p=HumanoidRootPart.Position
                HumanoidRootPart.CFrame=CFrame.new(p.X,y,p.Z)
            end
        end)
    end
    -- Следим за исчезновением
    obj.AncestryChanged:Connect(function()
        if not obj.Parent and rushActive then
            rushActive=false
            if rushUpEnabled and HumanoidRootPart and rushSavedY then
                local fromY=HumanoidRootPart.Position.Y
                SmoothY(fromY, rushSavedY, MOVE_DUR, function(y)
                    if HumanoidRootPart then
                        local p=HumanoidRootPart.Position
                        HumanoidRootPart.CFrame=CFrame.new(p.X,y,p.Z)
                    end
                end, function() RemovePlatform(); rushSavedY=nil; bypassAntiTp=false end)
            else
                bypassAntiTp=false
            end
        end
    end)
end

local function StartAmbush(obj)
    if rushNotif and not notifiedRush[obj] then
        notifiedRush[obj]=true
        SendNotif("⚠ ВНИМАНИЕ!","АМБУШ летит!")
    end
    if ambushDownEnabled and HumanoidRootPart and not ambushActive then
        ambushActive=true
        ambushSavedY=HumanoidRootPart.Position.Y
        CreatePlatform()
        SmoothY(ambushSavedY, ambushSavedY-OFFSET_Y, MOVE_DUR, function(y)
            if HumanoidRootPart then
                local p=HumanoidRootPart.Position
                HumanoidRootPart.CFrame=CFrame.new(p.X,y,p.Z)
            end
        end)
    end
    obj.AncestryChanged:Connect(function()
        if not obj.Parent and ambushActive then
            ambushActive=false
            if ambushDownEnabled and HumanoidRootPart and ambushSavedY then
                local fromY=HumanoidRootPart.Position.Y
                SmoothY(fromY, ambushSavedY, MOVE_DUR, function(y)
                    if HumanoidRootPart then
                        local p=HumanoidRootPart.Position
                        HumanoidRootPart.CFrame=CFrame.new(p.X,y,p.Z)
                    end
                end, function() RemovePlatform(); ambushSavedY=nil; bypassAntiTp=false end)
            else
                bypassAntiTp=false
            end
        end
    end)
end

