    local hrp = char:FindFirstChild("HumanoidRootPart")
    if on then
        if hrp then MakeESP(hrp,"PlayerESP","👤 "..plr.Name,Color3.fromRGB(100,200,255)) end
        MakeHighlight(char,"PlayerESP",Color3.fromRGB(100,200,255))
    else
        if hrp then RemoveESP(hrp,"PlayerESP") end
        RemoveHighlight(char,"PlayerESP")
    end
end
