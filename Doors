--  ROOM SUBSCRIPTION
-- ══════════════════════════════════════════════
local function SubscribeRoom(room)
    -- Двери — прямые дети
    for _, child in ipairs(room:GetChildren()) do
        if child.Name=="Door" and child:IsA("Model") and doorsESPEnabled then HandleDoor(child) end
    end
    room.ChildAdded:Connect(function(child)
        if child.Name=="Door" and child:IsA("Model") and doorsESPEnabled then HandleDoor(child) end
        HandleDescendant(child)
    end)
    -- Всё остальное
    for _, desc in ipairs(room:GetDescendants()) do HandleDescendant(desc) end
    room.DescendantAdded:Connect(HandleDescendant)
end

if currentRooms then
    for _, room in ipairs(currentRooms:GetChildren()) do SubscribeRoom(room) end
    currentRooms.ChildAdded:Connect(SubscribeRoom)
else
    Workspace.ChildAdded:Connect(function(child)
        if child.Name=="CurrentRooms" then
            currentRooms=child
            for _, room in ipairs(child:GetChildren()) do SubscribeRoom(room) end
            child.ChildAdded:Connect(SubscribeRoom)
        end
    end)
end

