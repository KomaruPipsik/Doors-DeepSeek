local function GetPrimaryPart(obj)
    if obj:IsA("BasePart") then return obj end
    return obj:FindFirstChildWhichIsA("BasePart",true)
end

local function MakeESP(part, tag, text, color)
    if not part or not part.Parent then return end
    if part:FindFirstChild(tag) then return end
    local bill = Instance.new("BillboardGui")
    bill.Name=tag; bill.Size=UDim2.new(0,150,0,40)
    bill.AlwaysOnTop=true; bill.StudsOffset=Vector3.new(0,3.5,0)
    bill.Adornee=part; bill.Parent=part
    local lbl=Instance.new("TextLabel")
    lbl.Size=UDim2.new(1,0,1,0); lbl.BackgroundTransparency=1
    lbl.Text=text; lbl.TextColor3=color
    lbl.TextStrokeTransparency=0; lbl.TextStrokeColor3=Color3.new(0,0,0)
    lbl.TextSize=14; lbl.Font=Enum.Font.GothamBold; lbl.Parent=bill
end

local function RemoveESP(part, tag)
    if not part then return end
    local b=part:FindFirstChild(tag); if b then b:Destroy() end
end

local function MakeHighlight(model, tag, color)
    if not model or not model.Parent then return end
    if model:FindFirstChild(tag.."_HL") then return end
    local hl=Instance.new("Highlight")
    hl.Name=tag.."_HL"; hl.Adornee=model
    hl.FillColor=color; hl.OutlineColor=color
    hl.FillTransparency=0.65; hl.OutlineTransparency=0
    hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
    hl.Parent=model
end

local function RemoveHighlight(model, tag)
    if not model then return end
    local h=model:FindFirstChild(tag.."_HL"); if h then h:Destroy() end
end

local function MakeItemESP(model, tag, label, color)
    task.spawn(function()
        task.wait(0.1)
        if not model.Parent then return end
        local part=GetPrimaryPart(model)
        if not part then return end
        if part:FindFirstChild(tag) then return end
        MakeESP(part,tag,label,color)
        MakeHighlight(model,tag,color)
        model.AncestryChanged:Connect(function()
            if not model.Parent then RemoveESP(part,tag); RemoveHighlight(model,tag) end
        end)
    end)
end

local function RemoveItemESP(model, tag)
    RemoveESP(GetPrimaryPart(model),tag)
    RemoveHighlight(model,tag)
end

