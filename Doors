local function SelectTab(name)
    for n,t in pairs(tabs) do
        local on=(n==name)
        t.btn.BackgroundColor3=on and TAB_ON or TAB_OFF
        t.btn.TextColor3=on and Color3.fromRGB(255,255,255) or Color3.fromRGB(140,140,160)
        t.page.Visible=on
    end
end

local function AddTab(icon,label)
    local btn=Instance.new("TextButton")
    btn.Size=UDim2.new(0,118,0,36); btn.Position=UDim2.new(0,6,0,tabY)
    tabY=tabY+41; btn.BackgroundColor3=TAB_OFF
    btn.Text=icon.."  "..label; btn.TextColor3=Color3.fromRGB(140,140,160)
    btn.TextSize=12; btn.Font=Enum.Font.GothamBold
    btn.TextXAlignment=Enum.TextXAlignment.Left; btn.AutoButtonColor=false; btn.Parent=TabPanel
    Instance.new("UICorner",btn).CornerRadius=UDim.new(0,8)
    local bp=Instance.new("UIPadding"); bp.PaddingLeft=UDim.new(0,8); bp.Parent=btn

    local page=Instance.new("ScrollingFrame")
    page.Size=UDim2.new(1,-6,1,-6); page.Position=UDim2.new(0,3,0,3)
    page.BackgroundTransparency=1; page.CanvasSize=UDim2.new(0,0,0,0)
    page.AutomaticCanvasSize=Enum.AutomaticSize.Y
    page.ScrollBarThickness=4; page.ScrollBarImageColor3=Color3.fromRGB(80,80,100)
    page.Visible=false; page.Parent=Content
    local ll=Instance.new("UIListLayout"); ll.SortOrder=Enum.SortOrder.LayoutOrder
