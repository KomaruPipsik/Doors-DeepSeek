-- ══════════════════════════════════════════════
--  ITEMS TABLE (новые предметы)
--  Формат: {parentName, childName, partName, label, color}
--  parentName = имя родителя (Table / RolltopContainer / SmoothieSpawner / AlarmClock)
--  childName  = имя ребёнка (Handle / GoldPile / Lighter / Vitamins / Smoothive / Candle / Main / nil)
--  partName   = имя BasePart внутри (Handle / Hitbox / Main / nil = любой)
-- ══════════════════════════════════════════════
-- Логика: находим parentName → ищем childName (если указан) → ищем partName или GetPrimaryPart

local ITEMS = {
    -- Пластырь: Table > Handle
    {parent="Table",    child="Handle",        part=nil,     label="🩹 ПЛАСТЫРЬ",  color=Color3.fromRGB(255,180,100)},
    -- Свеча: Table > Candle > Handle
    {parent="Table",    child="Candle",         part="Handle",label="🕯 СВЕЧА",     color=Color3.fromRGB(255,240,150)},
    -- Зажигалка: RolltopContainer > Lighter > Main
    {parent="RolltopContainer", child="Lighter",part="Main",  label="🔥 ЗАЖИГАЛКА",color=Color3.fromRGB(255,120,30)},
    -- Витамины: RolltopContainer > Vitamins > Main
    {parent="RolltopContainer", child="Vitamins",part="Main", label="💊 ВИТАМИНЫ",  color=Color3.fromRGB(160,255,80)},
    -- Сок: SmoothieSpawner > Smoothive > Main
    {parent="SmoothieSpawner",  child="Smoothive",part="Main",label="🥤 СОК",       color=Color3.fromRGB(100,220,100)},
    -- Будильник: AlarmClock > Main
    {parent="AlarmClock",       child="Main",   part=nil,     label="⏰ БУДИЛЬНИК", color=Color3.fromRGB(200,200,255)},
}

-- Быстрый lookup: parentName → список правил
local ITEMS_BY_PARENT = {}
for _, rule in ipairs(ITEMS) do
    if not ITEMS_BY_PARENT[rule.parent] then ITEMS_BY_PARENT[rule.parent] = {} end
    table.insert(ITEMS_BY_PARENT[rule.parent], rule)
end

local function TryItemESP(desc)
    if not itemsESP then return end
    local rules = ITEMS_BY_PARENT[desc.Name]
    if not rules then return end
    for _, rule in ipairs(rules) do
        -- Ищем child
        local target
        if rule.child then
            target = desc:FindFirstChild(rule.child)
        else
            target = desc
        end
        if target then
            -- Ищем part
            local part
            if rule.part then
                part = target:FindFirstChild(rule.part)
            else
                part = GetPrimaryPart(target) or target
            end
            if part then
                MakeESP(part, "ItemESP_"..rule.label, rule.label, rule.color)
                MakeHighlight(target, "ItemESP_"..rule.label, rule.color)
                target.AncestryChanged:Connect(function()
                    if not target.Parent then
                        RemoveESP(part, "ItemESP_"..rule.label)
                        RemoveHighlight(target, "ItemESP_"..rule.label)
                    end
                end)
            end
        end
    end
end

