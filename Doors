-- ── ROOM SUBSCRIPTION ──────────────────────────────────
SubscribeRoom=function(room)
    for _,ch in ipairs(room:GetChildren()) do
        if ch.Name=="Door" and ch:IsA("Model") and F.doors then HandleDoor(ch) end
    end
    for _,desc in ipairs(room:GetDescendants()) do HandleDesc(desc) end
    room.ChildAdded:Connect(function(ch)
        if ch.Name=="Door" and ch:IsA("Model") and F.doors then HandleDoor(ch) end
        HandleDesc(ch)
    end)
    room.DescendantAdded:Connect(HandleDesc)
    -- Следим за Water
    local assets=room:FindFirstChild("Assets")
    if assets then
        for _,o in ipairs(assets:GetChildren()) do
            if o.Name=="Water" and F.waterPool then HandleWater(o) end
        end
        assets.ChildAdded:Connect(function(o)
            if o.Name=="Water" and F.waterPool then HandleWater(o) end
        end)
        -- Следим за Loot > FloorLootItem
        local loot=assets:FindFirstChild("Loot")
        if loot then
            for _,fli in ipairs(loot:GetChildren()) do
                if fli.Name=="FloorLootItem" then HandleFloorLootItem(fli) end
            end
            loot.ChildAdded:Connect(function(fli)
                if fli.Name=="FloorLootItem" then HandleFloorLootItem(fli) end
            end)
        else
            -- Loot ещё не появился — ждём
            assets.ChildAdded:Connect(function(child)
                if child.Name=="Loot" then
                    child.ChildAdded:Connect(function(fli)
                        if fli.Name=="FloorLootItem" then HandleFloorLootItem(fli) end
                    end)
                    for _,fli in ipairs(child:GetChildren()) do
                        if fli.Name=="FloorLootItem" then HandleFloorLootItem(fli) end
                    end
                end
            end)
        end
    end
end

if currentRooms then
    for _,room in ipairs(currentRooms:GetChildren()) do SubscribeRoom(room) end
    currentRooms.ChildAdded:Connect(SubscribeRoom)
else
    Workspace.ChildAdded:Connect(function(ch)
        if ch.Name=="CurrentRooms" then
            currentRooms=ch
            for _,room in ipairs(ch:GetChildren()) do SubscribeRoom(room) end
            ch.ChildAdded:Connect(SubscribeRoom)
