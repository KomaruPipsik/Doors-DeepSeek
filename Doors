--// ========================
--// ГЛАВНЫЙ LOOP
--// ========================
local lastPosition = Vector3.new()
local scanTick = 0

RunService.Heartbeat:Connect(function(dt)
	-- Скорость
	if speedEnabled and Humanoid then
		Humanoid.WalkSpeed = customSpeed
	end

	-- FOV — обновляем каждый кадр чтобы работало
	Camera.FieldOfView = customFOV

	-- Анти-телепорт
	if antiTpEnabled and HumanoidRootPart then
		if (HumanoidRootPart.Position - lastPosition).Magnitude > 50
			and not Workspace:GetAttribute("InElevator") then
			HumanoidRootPart.CFrame = CFrame.new(lastPosition)
		else
			lastPosition = HumanoidRootPart.Position
		end
	elseif HumanoidRootPart then
		lastPosition = HumanoidRootPart.Position
	end

	-- Сканирование монстров (раз в 0.12 сек)
	scanTick = scanTick + dt
	if scanTick < 0.12 then return end
	scanTick = 0

	local wsChildren = Workspace:GetChildren()
	local rushFound = false
	local ambushFound = false

	for _, obj in ipairs(wsChildren) do
		local isRush = obj.Name == "RushMoving"
		local isAmbush = obj.Name == "AmbushMoving"

		if isRush or isAmbush then
			-- Уведомление
			if rushNotifications and not notifiedRush[obj] then
				notifiedRush[obj] = true
				SendNotification("⚠ ВНИМАНИЕ!", (isRush and "РАШ" or "АМБУШ") .. " летит!")
			end

			-- ESP
			if rushAmbushESP then
				local part = GetPrimaryPart(obj)
				if part then
					MakeESP(part, "RushAmbushESP",
						isRush and "💨 РАШ" or "🌀 АМБУШ",
						Color3.fromRGB(255, 60, 60))
				end
			end

			if isRush then
				rushFound = true
				-- Телепорт вверх при появлении Раша
				if rushRoofEnabled and HumanoidRootPart and not rushOnRoof then
					rushOnRoof = true
					rushSavedPos = HumanoidRootPart.Position
					HumanoidRootPart.CFrame = CFrame.new(rushSavedPos.X, roofY, rushSavedPos.Z)
				end
			end

			if isAmbush then
				ambushFound = true
				-- Телепорт вниз при появлении Амбуша
				if ambushDownEnabled and HumanoidRootPart and not ambushDown then
					ambushDown = true
					ambushSavedPos = HumanoidRootPart.Position
					HumanoidRootPart.CFrame = CFrame.new(ambushSavedPos.X, floorY, ambushSavedPos.Z)
				end
			end
		end

		-- Eyes
		if obj.Name == "Eyes" then
			if eyesESP then
				local part = GetPrimaryPart(obj)
				if part then MakeESP(part, "EyesESP", "👁 EYES", Color3.fromRGB(180, 0, 255)) end
			end
			if eyesAntiDamage then
				Camera.CFrame = CFrame.new(Camera.CFrame.Position,
					Camera.CFrame.Position + Vector3.new(0, -5, 5))
			end
		end
	end

	-- Возврат после Раша
	if not rushFound and rushOnRoof then
		rushOnRoof = false
		if rushRoofEnabled and HumanoidRootPart and rushSavedPos then
			HumanoidRootPart.CFrame = CFrame.new(rushSavedPos.X, rushSavedPos.Y, rushSavedPos.Z)
			rushSavedPos = nil
		end
	end

	-- Возврат после Амбуша
	if not ambushFound and ambushDown then
		ambushDown = false
		if ambushDownEnabled and HumanoidRootPart and ambushSavedPos then
			HumanoidRootPart.CFrame = CFrame.new(ambushSavedPos.X, ambushSavedPos.Y, ambushSavedPos.Z)
			ambushSavedPos = nil
		end
	end

	-- Screech
	for _, sName in ipairs({"Screech", "ScreechRetro", "ScreechRushMode"}) do
		local s = Workspace:FindFirstChild(sName, true)
		if s then
			if screechNotif and not s:GetAttribute("Notified") then
				s:SetAttribute("Notified", true)
				SendNotification("😱 SCREECH!", "Скрич появился!")
			end
			if screechAutoTurn then
				local part = s:FindFirstChild("HumanoidRootPart") or s:FindFirstChildWhichIsA("BasePart")
				if part then
					Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
				end
			end
		end
	end

	-- Figure
	if currentRooms then
		for _, room in ipairs(currentRooms:GetChildren()) do
			local rig = room:FindFirstChild("FigureRig", true) or room:FindFirstChild("FigureSetup", true)
			if rig then
				local pp = rig:FindFirstChild("HumanoidRootPart") or rig:FindFirstChildWhichIsA("BasePart")
				if pp then
					if figureESP then MakeESP(pp, "FigureESP", "👹 FIGURE", Color3.fromRGB(255, 0, 0)) end
					if figureAvoid and HumanoidRootPart and Humanoid then
						local dist = (HumanoidRootPart.Position - pp.Position).Magnitude
						if dist < avoidRadius then
							local dir = (HumanoidRootPart.Position - pp.Position).Unit
							Humanoid:Move(dir * 2)
						end
					end
				end
			end
		end
	end

	-- Игроки ESP
	if playerESPEnabled then
		for _, plr in ipairs(Players:GetPlayers()) do
			SetPlayerESP(plr, true)
		end
	end
end)

SendNotification("Doors v2.1 Загружен", "RightShift = меню")
