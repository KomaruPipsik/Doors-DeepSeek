-- 3. СЕРВИС МОНИТОРИНГА СУЩНОСТЕЙ (Entities)
-- ==========================================
local EntityService = {}

function EntityService.HandleCameraAversion(eyesModel)
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not eyesModel or not eyesModel.Parent then 
            connection:Disconnect() 
            return 
        end
        
        local core = eyesModel:FindFirstChild("Core") or eyesModel.PrimaryPart
        if not core then return end

        local camCFrame = Camera.CFrame
        local lookVector = camCFrame.LookVector
        local directionToEyes = (core.Position - camCFrame.Position).Unit
        local dotProduct = lookVector:Dot(directionToEyes)

        -- Если игрок смотрит на Eyes (угол обзора)
        if dotProduct > 0.45 then
            -- Плавно отворачиваем камеру вниз
            Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(camCFrame.Position, camCFrame.Position + Vector3.new(lookVector.X, -1, lookVector.Z)), 0.2)
        end
    end)
end

function EntityService.HandleScreech(screech)
    Utils.Notify("Угроза", "Обнаружен Screech! Камера наведена.")
    local connection
    connection = RunService.RenderStepped:Connect(function()
        if not screech or not screech.Parent then
            connection:Disconnect()
            return
        end
        
        local root = screech:FindFirstChild("HumanoidRootPart") or screech.PrimaryPart
        if root then
            -- Мгновенно поворачиваем камеру на скрича
            Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, root.Position)
        end
    end)
end

function EntityService.Initialize()
    Workspace.ChildAdded:Connect(function(child)
        -- Rush и Ambush
        if child.Name == "RushMoving" or child.Name == "AmbushMoving" then
            Utils.Notify("ВНИМАНИЕ", child.Name .. " приближается! Прячьтесь!")
        
        -- Eyes
        elseif child.Name == "Eyes" then
            Utils.Notify("Угроза", "Eyes появился! Отводим взгляд.")
            EntityService.HandleCameraAversion(child)
            
        -- Screech
        elseif child.Name == "Screech" or child.Name == "ScreechRetro" or child.Name == "ScreechRushMode" then
            EntityService.HandleScreech(child)
        end
    end)
end

