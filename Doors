function refreshItemsESP()
	if not currentRooms then return end
	for _, room in ipairs(currentRooms:GetChildren()) do
		for _, desc in ipairs(room:GetDescendants()) do
			if desc.Name == "RolltopContainer" then
				for _, child in ipairs(desc:GetChildren()) do
					if child.Name ~= "Lid" then
						local part = GetPrimaryPart(child) or child
						if part then
							if itemsESP then MakeESP(part, "ItemESP", "💊 " .. child.Name, Color3.fromRGB(180,255,100))
							else RemoveESP(part, "ItemESP") end
						end
					end
				end
			end
		end
	end
end

-- Вешаем DescendantAdded на каждую новую комнату
if currentRooms then
	currentRooms.ChildAdded:Connect(function(room)
		-- Сначала обрабатываем уже существующих потомков
		for _, desc in ipairs(room:GetDescendants()) do
			HandleDescendant(desc, room)
		end
		-- Потом ловим новых
		room.DescendantAdded:Connect(function(desc)
			HandleDescendant(desc, room)
		end)
	end)
	-- Уже загруженные комнаты
	for _, room in ipairs(currentRooms:GetChildren()) do
		for _, desc in ipairs(room:GetDescendants()) do
			HandleDescendant(desc, room)
		end
		room.DescendantAdded:Connect(function(desc)
			HandleDescendant(desc, room)
		end)
	end
end

