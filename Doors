function stopSeekLoop()
	seekActive = false
	if seekMoveLoop then
		seekMoveLoop:Disconnect()
		seekMoveLoop = nil
	end
	-- Вернуть игрока на место
	if originalCFrame and HumanoidRootPart then
		HumanoidRootPart.CFrame = originalCFrame
	end
	originalCFrame = nil
end

local function startSeekLoop()
	if seekActive then return end
	seekActive = true
	originalCFrame = HumanoidRootPart.CFrame
	-- Опустить игрока под пол (невидим для Seek)
	seekMoveLoop = RunService.Heartbeat:Connect(function()
		if not seekActive then return end
		if not HumanoidRootPart then return end
		-- Держим игрока низко
		local pos = HumanoidRootPart.Position
		HumanoidRootPart.CFrame = CFrame.new(pos.X, floorY, pos.Z)
	end)
end

