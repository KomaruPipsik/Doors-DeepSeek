local function GetPrimaryPart(obj)
	if obj:IsA("BasePart") then return obj end
	return obj:FindFirstChildWhichIsA("BasePart", true)
end

-- Billboard (текст над объектом)
local function MakeESP(part, tag, text, color)
	if not part or not part.Parent then return end
	if part:FindFirstChild(tag) then return end
	local bill = Instance.new("BillboardGui")
	bill.Name = tag
	bill.Size = UDim2.new(0, 130, 0, 40)
	bill.AlwaysOnTop = true
	bill.StudsOffset = Vector3.new(0, 3.5, 0)
	bill.Adornee = part
	bill.Parent = part
	local lbl = Instance.new("TextLabel")
	lbl.Size = UDim2.new(1, 0, 1, 0)
	lbl.BackgroundTransparency = 1
	lbl.Text = text
	lbl.TextColor3 = color
	lbl.TextStrokeTransparency = 0
	lbl.TextStrokeColor3 = Color3.new(0, 0, 0)
	lbl.TextSize = 14
	lbl.Font = Enum.Font.SourceSansBold
	lbl.Parent = bill
end

local function RemoveESP(part, tag)
	if not part then return end
	local b = part:FindFirstChild(tag)
	if b then b:Destroy() end
end

-- SelectionBox обводка на модель целиком
local function MakeOutline(model, tag, color)
	-- Ищем уже существующую обводку
	local existingParent = model:FindFirstChild(tag .. "_outline")
	if existingParent then return end

	-- Маркер чтобы не дублировать
	local marker = Instance.new("BoolValue")
	marker.Name = tag .. "_outline"
	marker.Parent = model

	local box = Instance.new("SelectionBox")
	box.Name = tag .. "_box"
	box.Adornee = model
	box.Color3 = color
	box.LineThickness = 0.05
	box.SurfaceTransparency = 0.75
	box.SurfaceColor3 = color
	box.Parent = model
end

local function RemoveOutline(model, tag)
	if not model then return end
	local m = model:FindFirstChild(tag .. "_outline")
	if m then m:Destroy() end
	local b = model:FindFirstChild(tag .. "_box")
	if b then b:Destroy() end
end

--// ========================
--// Двери ESP — только правильная дверь
--// Логика: правильная дверь в DOORS — это та что НЕ помечена как дубль
--// И у неё есть компонент "OpenDoor" или она называется "Door" (не dupeDoor)
--// ========================
local function HandleDoor(door)
	-- Проверяем: это дубль дверь?
	local isDupe = door.Name == "dupeDoor"
		or door:FindFirstChild("dupeDoor") ~= nil
		or door:GetAttribute("isDupe") == true

	-- Правильную дверь помечаем, дубль — нет
	if not isDupe then
		local part = GetPrimaryPart(door)
		if part then
			MakeESP(part, "DoorsESP", "✅ ПРАВИЛЬНАЯ", Color3.fromRGB(60, 255, 60))
		end
		door.AncestryChanged:Connect(function()
			if not door.Parent then RemoveESP(part, "DoorsESP") end
		end)
	end
end

--// Предметы с обводкой
local function MakeItemESP(model, tag, label, color)
	local part = GetPrimaryPart(model)
	if not part then return end
	MakeESP(part, tag, label, color)
	MakeOutline(model, tag, color)
	model.AncestryChanged:Connect(function()
		if not model.Parent then
			RemoveESP(part, tag)
			RemoveOutline(model, tag)
		end
	end)
end

local function RemoveItemESP(model, tag)
	local part = GetPrimaryPart(model)
	RemoveESP(part, tag)
	RemoveOutline(model, tag)
end

--// Обработчик потомков комнаты
local function HandleDescendant(desc)
	-- Двери
	if desc.Name == "Door" then
		if doorsESPEnabled then HandleDoor(desc) end
		return
	end

	-- Ключ — KeyObtain или в мебели
	if desc.Name == "KeyObtain" and keyESPEnabled then
		MakeItemESP(desc, "KeyESP", "🔑 КЛЮЧ", Color3.fromRGB(255, 220, 0))
		return
	end

	-- Ключ в Dresser / DrawerContainer
	if (desc.Name == "Dresser" or desc.Name == "DrawerContainer") and keyESPEnabled then
		local k = desc:FindFirstChild("KeyObtain", true)
		if k then
			MakeItemESP(k, "KeyESP", "🔑 КЛЮЧ", Color3.fromRGB(255, 220, 0))
		end
		return
	end

	-- Рычаг
	if desc.Name == "LeverForGate" and leverESPEnabled then
		local part = GetPrimaryPart(desc)
		if part then MakeESP(part, "LeverESP", "🔧 РЫЧАГ", Color3.fromRGB(255, 255, 0)) end
		return
	end

	-- Книги
	if desc.Name == "LiveHintBook" and booksESP then
		MakeItemESP(desc, "BookESP", "📖 КНИГА", Color3.fromRGB(0, 210, 255))
		return
	end

	-- Crucifix (крест — сама модель CrucifixWall)
	if desc.Name == "CrucifixWall" and crucifixESP then
		MakeItemESP(desc, "CrucifixESP", "✝ КРЕСТ", Color3.fromRGB(255, 200, 50))
		return
	end

	-- Предметы в столе (RolltopContainer, всё кроме Lid)
	if desc.Name == "RolltopContainer" and itemsESP then
		for _, child in ipairs(desc:GetChildren()) do
			if child.Name ~= "Lid" then
				MakeItemESP(child, "ItemESP", "💊 " .. child.Name, Color3.fromRGB(160, 255, 80))
			end
		end
		desc.ChildAdded:Connect(function(child)
			if child.Name ~= "Lid" and itemsESP then
				MakeItemESP(child, "ItemESP", "💊 " .. child.Name, Color3.fromRGB(160, 255, 80))
			end
		end)
		return
	end

	-- Ловушки
	if desc.Name == "Snare" and snareESP then
		local base = desc:FindFirstChild("SnareBase") or desc
		local part = GetPrimaryPart(base) or base
		MakeESP(part, "SnareESP", "⚠ ЛОВУШКА", Color3.fromRGB(255, 128, 0))
		return
	end

	-- Рычаги 100
	if desc.Name == "LiveBreakerPolePickup" and polesESP then
		local part = GetPrimaryPart(desc) or desc
		MakeESP(part, "PoleESP", "⚡ РЫЧАГ 100", Color3.fromRGB(60, 255, 60))
		return
	end
end

--// Refresh при включении Toggle (для уже загруженных комнат)
local currentRooms = Workspace:FindFirstChild("CurrentRooms")

local function ScanRooms(filterFn)
	if not currentRooms then return end
	for _, room in ipairs(currentRooms:GetChildren()) do
		for _, desc in ipairs(room:GetDescendants()) do
			filterFn(desc)
		end
	end
end

function refreshDoorsESP()
	ScanRooms(function(desc)
		if desc.Name == "Door" then
			local part = GetPrimaryPart(desc)
			if doorsESPEnabled then
				HandleDoor(desc)
			else
				RemoveESP(part, "DoorsESP")
			end
		end
	end)
end

function refreshKeysESP()
	ScanRooms(function(desc)
		if desc.Name == "KeyObtain" then
			if keyESPEnabled then MakeItemESP(desc, "KeyESP", "🔑 КЛЮЧ", Color3.fromRGB(255, 220, 0))
			else RemoveItemESP(desc, "KeyESP") end
		end
	end)
end

function refreshBooksESP()
	ScanRooms(function(desc)
		if desc.Name == "LiveHintBook" then
			if booksESP then MakeItemESP(desc, "BookESP", "📖 КНИГА", Color3.fromRGB(0, 210, 255))
			else RemoveItemESP(desc, "BookESP") end
		end
	end)
end

function refreshCrucifixESP()
	ScanRooms(function(desc)
		if desc.Name == "CrucifixWall" then
			if crucifixESP then MakeItemESP(desc, "CrucifixESP", "✝ КРЕСТ", Color3.fromRGB(255, 200, 50))
			else RemoveItemESP(desc, "CrucifixESP") end
		end
	end)
end

function refreshItemsESP()
	ScanRooms(function(desc)
		if desc.Name == "RolltopContainer" then
			for _, child in ipairs(desc:GetChildren()) do
				if child.Name ~= "Lid" then
					if itemsESP then MakeItemESP(child, "ItemESP", "💊 " .. child.Name, Color3.fromRGB(160, 255, 80))
					else RemoveItemESP(child, "ItemESP") end
				end
			end
		end
	end)
end

--// Подписка на новые комнаты и их потомков
local function SubscribeRoom(room)
	for _, desc in ipairs(room:GetDescendants()) do
		HandleDescendant(desc)
	end
	room.DescendantAdded:Connect(HandleDescendant)
end

if currentRooms then
	for _, room in ipairs(currentRooms:GetChildren()) do
		SubscribeRoom(room)
	end
	currentRooms.ChildAdded:Connect(SubscribeRoom)
else
	-- Если CurrentRooms ещё не появился
	Workspace.ChildAdded:Connect(function(child)
		if child.Name == "CurrentRooms" then
			currentRooms = child
			for _, room in ipairs(child:GetChildren()) do
				SubscribeRoom(room)
			end
			child.ChildAdded:Connect(SubscribeRoom)
		end
	end)
end

