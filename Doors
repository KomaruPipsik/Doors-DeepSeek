--// ГЛАВНЫЙ LOOP (только динамика)
--// ========================
local lastPosition = Vector3.new()

RunService.Heartbeat:Connect(function()
	-- Скорость
	if speedEnabled and Humanoid then
		Humanoid.WalkSpeed = customSpeed
	end

	-- Анти-телепорт
	if antiTpEnabled and HumanoidRootPart then
		if (HumanoidRootPart.Position - lastPosition).Magnitude > 50 and not Workspace:GetAttribute("InElevator") then
			HumanoidRootPart.CFrame = CFrame.new(lastPosition)
		else
			lastPosition = HumanoidRootPart.Position
		end
	elseif HumanoidRootPart then
		lastPosition = HumanoidRootPart.Position
	end
end)

-- Мировой скан (монстры) — реже, чем Heartbeat
local scanTick = 0
RunService.RenderStepped:Connect(function(dt)
	scanTick = scanTick + dt
	if scanTick < 0.15 then return end -- сканируем раз в 0.15 сек, не каждый кадр
	scanTick = 0

	local wsChildren = Workspace:GetChildren()

	-- Rush & Ambush
	local rushFound = false
	local ambushFound = false
	for _, obj in ipairs(wsChildren) do
		local isRush = obj.Name == "RushMoving"
		local isAmbush = obj.Name == "AmbushMoving"
		if isRush or isAmbush then
			-- Уведомление
			if rushNotifications and not notifiedRush[obj] then
				notifiedRush[obj] = true
				SendNotification("⚠ ВНИМАНИЕ!", obj.Name .. " летит!")
			end
			-- ESP
			if rushAmbushESP then
				local part = GetPrimaryPart(obj)
				if part then
					local lbl = isRush and "💨 РАШ" or "🌀 АМБУШ"
					MakeESP(part, "RushAmbushESP", lbl, Color3.fromRGB(255, 60, 60))
				end
			end
			-- Телепорт Rush → крыша
			if isRush then
				rushFound = true
				if rushRoofEnabled and HumanoidRootPart and not rushOnRoof then
					rushOnRoof = true
					rushSavedY = HumanoidRootPart.Position.Y
					local pos = HumanoidRootPart.Position
					HumanoidRootPart.CFrame = CFrame.new(pos.X, roofY, pos.Z)
				end
			end
			-- Телепорт Ambush → вниз
			if isAmbush then
				ambushFound = true
				if ambushDownEnabled and HumanoidRootPart and not ambushDown then
					ambushDown = true
					local pos = HumanoidRootPart.Position
					HumanoidRootPart.CFrame = CFrame.new(pos.X, floorY, pos.Z)
				end
			end
		end
	end

	-- Возврат после Rush
	if not rushFound and rushOnRoof then
		rushOnRoof = false
		if rushRoofEnabled and HumanoidRootPart and rushSavedY then
			local pos = HumanoidRootPart.Position
			HumanoidRootPart.CFrame = CFrame.new(pos.X, rushSavedY, pos.Z)
		end
	end
	if not ambushFound and ambushDown then
		ambushDown = false
	end

	-- Eyes
	for _, obj in ipairs(wsChildren) do
		if obj.Name == "Eyes" then
			if eyesESP then
				local part = GetPrimaryPart(obj)
				if part then MakeESP(part, "EyesESP", "👁 EYES", Color3.fromRGB(180, 0, 255)) end
			end
			if eyesAntiDamage and HumanoidRootPart then
				Camera.CFrame = CFrame.new(Camera.CFrame.Position, Camera.CFrame.Position + Vector3.new(0, -5, 5))
			end
		end
	end

	-- Screech
	for _, name in ipairs({"Screech", "ScreechRetro", "ScreechRushMode"}) do
		local s = Workspace:FindFirstChild(name, true)
		if s then
			if screechNotif and not s:GetAttribute("Notified") then
				s:SetAttribute("Notified", true)
				SendNotification("😱 SCREECH!", "Скрич появился!")
			end
			if screechAutoTurn then
				local part = s:FindFirstChild("HumanoidRootPart") or s:FindFirstChildWhichIsA("BasePart")
				if part then
					Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position)
				end
			end
		end
	end

	-- Seek авто-уклон
	if seekAutoRun then
		local seek = Workspace:FindFirstChild("SeekMovingNewClone")
		if seek and not seekActive then
			startSeekLoop()
		elseif not seek and seekActive then
			stopSeekLoop()
		end
	end

	-- Figure
	if currentRooms then
		for _, room in ipairs(currentRooms:GetChildren()) do
			local rig = room:FindFirstChild("FigureRig", true) or room:FindFirstChild("FigureSetup", true)
			if rig then
				local pp = rig:FindFirstChild("HumanoidRootPart") or rig:FindFirstChildWhichIsA("BasePart")
				if pp then
					if figureESP then MakeESP(pp, "FigureESP", "👹 FIGURE", Color3.fromRGB(255, 0, 0)) end
					if figureAvoid and HumanoidRootPart and Humanoid then
						local dist = (HumanoidRootPart.Position - pp.Position).Magnitude
						if dist < avoidRadius then
							local dir = (HumanoidRootPart.Position - pp.Position).Unit
							Humanoid:Move(dir * 2)
						end
					end
				end
			end
		end
	end

	-- Игроки ESP
	if playerESPEnabled then
		UpdatePlayerESP()
	end
end)

SendNotification("Doors v2.0 Загружен", "RightShift = меню. Лаги исправлены!")
