--  FREECAM
-- ══════════════════════════════════════════════
local freecamSpeed   = 20
local freecamPitch   = 0
local freecamYaw     = 0
local freecamConn    = nil
local recordConn     = nil
local RECORD_INTERVAL = 0.15 -- секунд между точками

function StartFreecam()
    if freecamActive then return end
    freecamActive = true
    Camera.CameraType = Enum.CameraType.Scriptable
    freecamCam = Camera.CFrame
    freecamPitch = 0
    freecamYaw   = 0

    -- Скрываем персонажа
    if Character then
        for _, p in ipairs(Character:GetDescendants()) do
            if p:IsA("BasePart") then p.LocalTransparencyModifier = 1 end
        end
    end

    freecamConn = RunService.RenderStepped:Connect(function(dt)
        if not freecamActive then return end

        -- Мышь
        local md = UserInputService:GetMouseDelta()
        freecamYaw   = freecamYaw   - md.X * 0.3
        freecamPitch = math.clamp(freecamPitch - md.Y * 0.3, -89, 89)

        local rot = CFrame.Angles(0, math.rad(freecamYaw), 0)
            * CFrame.Angles(math.rad(freecamPitch), 0, 0)

        -- WASD движение
        local move = Vector3.new()
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then move = move + Vector3.new(0,0,-1) end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then move = move + Vector3.new(0,0,1)  end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then move = move + Vector3.new(-1,0,0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then move = move + Vector3.new(1,0,0)  end
        if UserInputService:IsKeyDown(Enum.KeyCode.E) then move = move + Vector3.new(0,1,0)  end
        if UserInputService:IsKeyDown(Enum.KeyCode.Q) then move = move + Vector3.new(0,-1,0) end

        -- Shift = быстро
        local spd = freecamSpeed * dt * (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 3 or 1)
        freecamCam = freecamCam + rot * (move * spd)
        freecamCam = CFrame.new(freecamCam.Position) * rot

        Camera.CFrame = freecamCam

        -- Блокируем мышь
        UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
    end)

    -- Запись пути
    recordConn = RunService.Heartbeat:Connect(function()
        if not freecamActive then return end
        if not recordingPath then return end
        local last = recordedPoints[#recordedPoints]
        local pos  = freecamCam.Position
        if not last or (pos - last).Magnitude > 1.5 then
            table.insert(recordedPoints, pos)
            -- Добавляем шарик хвостика
            local ball = Instance.new("Part")
            ball.Size = Vector3.new(0.4,0.4,0.4)
            ball.Shape = Enum.PartType.Ball
            ball.Anchored = true
            ball.CanCollide = false
            ball.CastShadow = false
            ball.Material = Enum.Material.Neon
            ball.BrickColor = BrickColor.new("Cyan")
            ball.CFrame = CFrame.new(pos)
            ball.Parent = Workspace
            table.insert(pathTrail, ball)
        end
    end)
end

function StopFreecam()
    if not freecamActive then return end
    freecamActive = false
    if freecamConn then freecamConn:Disconnect(); freecamConn=nil end
    if recordConn  then recordConn:Disconnect();  recordConn=nil  end
    Camera.CameraType = Enum.CameraType.Custom
    UserInputService.MouseBehavior = Enum.MouseBehavior.Default
    -- Возвращаем видимость персонажа
    if Character then
        for _, p in ipairs(Character:GetDescendants()) do
            if p:IsA("BasePart") then p.LocalTransparencyModifier = 0 end
        end
    end
end

-- ══════════════════════════════════════════════
--  ВОСПРОИЗВЕДЕНИЕ ПУТИ
-- ══════════════════════════════════════════════
function PlayPath()
    if isPlayingPath or #recordedPoints < 2 then return end
    isPlayingPath = true
    bypassAntiTp  = true

    -- Платформа под игроком
    pathPlatform = Instance.new("Part")
    pathPlatform.Name = "_PathPlatform"
    pathPlatform.Size = Vector3.new(8,0.4,8)
    pathPlatform.Anchored = true
    pathPlatform.CanCollide = true
    pathPlatform.Transparency = 0.4
    pathPlatform.BrickColor = BrickColor.new("Bright blue")
    pathPlatform.Material = Enum.Material.Neon
    pathPlatform.Parent = Workspace

    task.spawn(function()
        for i = 1, #recordedPoints do
            if not isPlayingPath then break end
            local target = recordedPoints[i]
            -- Плавно двигаемся к следующей точке
            local startPos = HumanoidRootPart and HumanoidRootPart.Position or target
            local dist = (target - startPos).Magnitude
            local duration = dist / pathPlaySpeed
            local t0 = tick()
            while tick() - t0 < duration do
                if not isPlayingPath then break end
                local pct = math.clamp((tick()-t0)/math.max(duration,0.01),0,1)
                local pos = startPos:Lerp(target, pct)
                if HumanoidRootPart then
                    HumanoidRootPart.CFrame = CFrame.new(pos)
                end
                if pathPlatform then
                    pathPlatform.CFrame = CFrame.new(pos.X, pos.Y-3.2, pos.Z)
                end
                RunService.Heartbeat:Wait()
            end
            if HumanoidRootPart then
                HumanoidRootPart.CFrame = CFrame.new(target)
            end
        end
        isPlayingPath = false
        bypassAntiTp  = false
        if pathPlatform then pathPlatform:Destroy(); pathPlatform=nil end
        -- Убираем хвостик
        for _, p in ipairs(pathTrail) do pcall(function() p:Destroy() end) end
        pathTrail = {}
    end)
end

