local TAB_OFF = Color3.fromRGB(32, 32, 42)
local TAB_ON  = Color3.fromRGB(55, 90, 200)
local BTN_OFF = Color3.fromRGB(30, 30, 40)
local BTN_ON  = Color3.fromRGB(28, 58, 28)

local tabs = {}
local activeTab = nil

local function SelectTab(name)
    for n, t in pairs(tabs) do
        local on = (n == name)
        t.btn.BackgroundColor3 = on and TAB_ON or TAB_OFF
        t.btn.TextColor3 = on and Color3.fromRGB(255,255,255) or Color3.fromRGB(140,140,160)
        t.page.Visible = on
    end
    activeTab = name
end

local tabYOffset = 10
local function AddTab(icon, label)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 118, 0, 36)
    btn.Position = UDim2.new(0, 6, 0, tabYOffset)
    tabYOffset = tabYOffset + 41
    btn.BackgroundColor3 = TAB_OFF
    btn.Text = icon .. "  " .. label
    btn.TextColor3 = Color3.fromRGB(140,140,160)
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamBold
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.Parent = TabPanel
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    local bp = Instance.new("UIPadding"); bp.PaddingLeft = UDim.new(0,10); bp.Parent = btn

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, -6, 1, -6)
    page.Position = UDim2.new(0, 3, 0, 3)
    page.BackgroundTransparency = 1
    page.CanvasSize = UDim2.new(0,0,0,0)
    page.AutomaticCanvasSize = Enum.AutomaticSize.Y
    page.ScrollBarThickness = 4
    page.ScrollBarImageColor3 = Color3.fromRGB(80,80,100)
    page.Visible = false
    page.Parent = ContentArea

    local list = Instance.new("UIListLayout")
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Padding = UDim.new(0, 5)
    list.Parent = page

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0,4); pad.PaddingRight = UDim.new(0,4)
    pad.Parent = page

    tabs[label] = {btn=btn, page=page}
    btn.MouseButton1Click:Connect(function() SelectTab(label) end)
    return page
end

local function AddLabel(page, text)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,0,0,20)
    lbl.BackgroundColor3 = Color3.fromRGB(35,35,52)
    lbl.Text = "  " .. text
    lbl.TextColor3 = Color3.fromRGB(120,150,255)
    lbl.TextSize = 11
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = page
    Instance.new("UICorner", lbl).CornerRadius = UDim.new(0,5)
end

local function AddToggle(page, name, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1,0,0,33)
    btn.BackgroundColor3 = BTN_OFF
    btn.Text = "  ○  " .. name
    btn.TextColor3 = Color3.fromRGB(200,80,80)
    btn.TextSize = 12
    btn.Font = Enum.Font.GothamSemibold
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.AutoButtonColor = false
    btn.Parent = page
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0,7)
    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = (state and "  ●  " or "  ○  ") .. name
        btn.TextColor3 = state and Color3.fromRGB(80,220,100) or Color3.fromRGB(200,80,80)
        btn.BackgroundColor3 = state and BTN_ON or BTN_OFF
        callback(state)
    end)
end

local function AddSlider(page, name, minV, maxV, default, callback)
    local con = Instance.new("Frame")
    con.Size = UDim2.new(1,0,0,52)
    con.BackgroundColor3 = BTN_OFF
    con.Parent = page
    Instance.new("UICorner", con).CornerRadius = UDim.new(0,7)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1,-8,0,22); lbl.Position = UDim2.new(0,8,0,2)
    lbl.BackgroundTransparency = 1
    lbl.Text = name..": "..tostring(default)
    lbl.TextColor3 = Color3.fromRGB(210,210,210)
    lbl.TextSize = 12; lbl.Font = Enum.Font.GothamSemibold
    lbl.TextXAlignment = Enum.TextXAlignment.Left; lbl.Parent = con

    local bar = Instance.new("TextButton")
    bar.Size = UDim2.new(0.92,0,0,9); bar.Position = UDim2.new(0.04,0,0,36)
    bar.BackgroundColor3 = Color3.fromRGB(50,50,65); bar.Text = ""; bar.Parent = con
    Instance.new("UICorner", bar).CornerRadius = UDim.new(0,4)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new((default-minV)/(maxV-minV),0,1,0)
    fill.BackgroundColor3 = Color3.fromRGB(55,100,230); fill.BorderSizePixel=0; fill.Parent=bar
    Instance.new("UICorner", fill).CornerRadius = UDim.new(0,4)

    local drag2=false
    bar.InputBegan:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag2=true end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 then drag2=false end end)
    UserInputService.InputChanged:Connect(function(i)
        if drag2 and i.UserInputType==Enum.UserInputType.MouseMovement then
            local pct=math.clamp((UserInputService:GetMouseLocation().X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X,0,1)
            fill.Size=UDim2.new(pct,0,1,0)
            local val=math.floor(minV+(maxV-minV)*pct)
            lbl.Text=name..": "..tostring(val)
            callback(val)
        end
    end)
end

