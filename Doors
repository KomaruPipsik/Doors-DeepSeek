-- 7. Screech Handler
local screechAutoTurn = false
local screechNotif = false
CreateToggle("Screech Notifications", function(state) screechNotif = state end)
CreateToggle("Screech Auto-Turn Camera", function(state) screechAutoTurn = state end)

RunService.RenderStepped:Connect(function()
	local entities = ReplicatedStorage:FindFirstChild("Entities")
	if not entities then return end
	for _, name in ipairs({"Screech", "ScreechRetro", "ScreechRushMode"}) do
		-- Check in workspace if spawned
		local activeScreech = Workspace:FindFirstChild(name)
		if activeScreech then
			if screechNotif and not activeScreech:GetAttribute("Notified") then
				activeScreech:SetAttribute("Notified", true)
				SendNotification("SCREECH!", "Screech has appeared!")
			end
			if screechAutoTurn and HumanoidRootPart then
				local p = activeScreech:FindFirstChildWhichIsA("BasePart")
				if p then
					workspace.CurrentCamera.CFrame = CFrame.new(workspace.CurrentCamera.CFrame.Position, p.Position)
				end
			end
		end
	end
end)

-- 8. Figure ESP & Bypass/Avoidance (Room 50)
local figureESP = false
local figureAvoid = false
local avoidRadius = 15
CreateToggle("Figure ESP", function(state) figureESP = state end)
CreateToggle("Figure Avoidance", function(state) figureAvoid = state end)
CreateSlider("Figure Avoid Radius", 10, 40, 15, function(val) avoidRadius = val end)

RunService.RenderStepped:Connect(function()
	local currentRooms = Workspace:FindFirstChild("CurrentRooms")
	if not currentRooms then return end
	for _, room in ipairs(currentRooms:GetChildren()) do
		local figSetup = room:FindFirstChild("FigureSetup") or room:FindFirstChild("FigureRig", true)
		if figSetup then
			local rig = room:FindFirstChild("FigureRig", true) or figSetup
			if rig then
				local part = rig:FindFirstChild("HumanoidRootPart") or rig:FindFirstChildWhichIsA("BasePart")
				if part then
					if figureESP and not part:FindFirstChild("FigBill") then
						local b = Instance.new("BillboardGui", part)
						b.Name = "FigBill"
						b.Size = UDim2.new(0, 100, 0, 40)
						b.AlwaysOnTop = true
						local t = Instance.new("TextLabel", b)
						t.Size = UDim2.new(1, 0, 1, 0)
						t.BackgroundTransparency = 1
						t.Text = "FIGURE"
						t.TextColor3 = Color3.fromRGB(255, 0, 0)
						t.Font = Enum.Font.SourceSansBold
						t.TextSize = 16
					end
					if figureAvoid and Humanoid and HumanoidRootPart then
						local dist = (HumanoidRootPart.Position - part.Position).Magnitude
						if dist < avoidRadius then
							local dir = (HumanoidRootPart.Position - part.Position).Unit
							Humanoid:Move(dir * 2)
						end
					end
				end
			end
		end
	end
end)

