-- ── SMOOTH MOVE ────────────────────────────────────────
local function SmoothY(fromY,toY,dur,onStep,onDone)
    local t0=tick(); bypassAntiTp=true
    local conn; conn=RunService.Heartbeat:Connect(function()
        if not HRP then conn:Disconnect(); bypassAntiTp=false; return end
        local pct=math.clamp((tick()-t0)/dur,0,1)
        local ease=pct*pct*(3-2*pct)
        onStep(fromY+(toY-fromY)*ease)
        if pct>=1 then conn:Disconnect(); if onDone then onDone() end end
    end)
end

