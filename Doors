local DROPS_MAP = {
    LaserPointer = "🔴 ЛАЗЕР",
    Leftovers    = "🍱 ЛАНЧБОКС",
    FishFlakes   = "🐟 КАВА",
    Pizza        = "🍕 ПИЦЦА",
}
local DROPS_COLOR = {
    LaserPointer = Color3.fromRGB(255,50,50),
    Leftovers    = Color3.fromRGB(255,200,80),
    FishFlakes   = Color3.fromRGB(80,200,255),
    Pizza        = Color3.fromRGB(255,140,0),
}

HandleDrop = function(drop)
    if not dropsESP then return end
    local function tryChild(child)
        local label = DROPS_MAP[child.Name]
        if not label then return end
        local color = DROPS_COLOR[child.Name]
        task.spawn(function()
            task.wait(0.1)
            if not child.Parent then return end
            local part = GetPrimaryPart(child) or child:FindFirstChildWhichIsA("BasePart",true)
            if part then MakeESP(part,"DropESP",label,color) end
            MakeHighlight(child,"DropESP",color)
            child.AncestryChanged:Connect(function()
                if not child.Parent then
                    RemoveESP(part,"DropESP")
                    RemoveHighlight(child,"DropESP")
                end
            end)
        end)
    end
    for _, child in ipairs(drop:GetChildren()) do tryChild(child) end
    drop.ChildAdded:Connect(tryChild)
end

HandleDrone = function(obj)
    if not dronesESP then return end
    if obj:FindFirstChild("DroneESP_HL") then return end
    MakeHighlight(obj,"DroneESP",Color3.fromRGB(180,180,180))
    obj.AncestryChanged:Connect(function()
        if not obj.Parent then RemoveHighlight(obj,"DroneESP") end
    end)
end

-- Следим за Drops в Workspace
Workspace.ChildAdded:Connect(function(obj)
    if obj.Name=="Drops" then HandleDrop(obj) end
end)

