-- ── FREECAM ────────────────────────────────────────────
local fcSpd=20; local fcPitch2=0; local fcYaw2=0

function StartFreecam()
    if fcActive then return end; fcActive=true
    Camera.CameraType=Enum.CameraType.Scriptable; fcCam=Camera.CFrame
    fcPitch2=0; fcYaw2=0
    if Character then
        for _,p in ipairs(Character:GetDescendants()) do
            if p:IsA("BasePart") then p.LocalTransparencyModifier=1 end
        end
    end
    fcConn=RunService.RenderStepped:Connect(function(dt)
        if not fcActive then return end
        local md=UIS:GetMouseDelta()
        fcYaw2=fcYaw2-md.X*0.3; fcPitch2=math.clamp(fcPitch2-md.Y*0.3,-89,89)
        local rot=CFrame.Angles(0,math.rad(fcYaw2),0)*CFrame.Angles(math.rad(fcPitch2),0,0)
        local mv=Vector3.new()
        if UIS:IsKeyDown(Enum.KeyCode.W) then mv=mv+Vector3.new(0,0,-1) end
        if UIS:IsKeyDown(Enum.KeyCode.S) then mv=mv+Vector3.new(0,0,1) end
        if UIS:IsKeyDown(Enum.KeyCode.A) then mv=mv+Vector3.new(-1,0,0) end
        if UIS:IsKeyDown(Enum.KeyCode.D) then mv=mv+Vector3.new(1,0,0) end
        if UIS:IsKeyDown(Enum.KeyCode.E) then mv=mv+Vector3.new(0,1,0) end
        if UIS:IsKeyDown(Enum.KeyCode.Q) then mv=mv+Vector3.new(0,-1,0) end
        local spd2=fcSpd*dt*(UIS:IsKeyDown(Enum.KeyCode.LeftShift) and 3 or 1)
        fcCam=fcCam+rot*(mv*spd2); fcCam=CFrame.new(fcCam.Position)*rot
        Camera.CFrame=fcCam; UIS.MouseBehavior=Enum.MouseBehavior.LockCenter
    end)
    recConn=RunService.Heartbeat:Connect(function()
        if not fcActive or not F.recPath then return end
        local last=recPoints[#recPoints]; local pos=fcCam.Position
        if not last or (pos-last).Magnitude>1.5 then
            table.insert(recPoints,pos)
            local ball=Instance.new("Part"); ball.Size=Vector3.new(0.4,0.4,0.4)
            ball.Shape=Enum.PartType.Ball; ball.Anchored=true; ball.CanCollide=false
            ball.CastShadow=false; ball.Material=Enum.Material.Neon
            ball.BrickColor=BrickColor.new("Cyan"); ball.CFrame=CFrame.new(pos); ball.Parent=Workspace
            table.insert(trail,ball)
        end
    end)
end

function StopFreecam()
    if not fcActive then return end; fcActive=false
    if fcConn then fcConn:Disconnect(); fcConn=nil end
    if recConn then recConn:Disconnect(); recConn=nil end
    Camera.CameraType=Enum.CameraType.Custom; UIS.MouseBehavior=Enum.MouseBehavior.Default
    if Character then
        for _,p in ipairs(Character:GetDescendants()) do
            if p:IsA("BasePart") then p.LocalTransparencyModifier=0 end
        end
    end
end

function PlayPath()
    if playing or #recPoints<2 then return end
    playing=true; bypassAntiTp=true
    pathPlt=MakePlt(BrickColor.new("Bright blue"))
    task.spawn(function()
        for i=1,#recPoints do
            if not playing then break end
            local tgt=recPoints[i]
            local startP=HRP and HRP.Position or tgt
            local dist=(tgt-startP).Magnitude
            local dur=dist/math.max(pathSpd,1)
            local t0=tick()
            while tick()-t0<dur do
                if not playing then break end
                local pct=math.clamp((tick()-t0)/math.max(dur,0.01),0,1)
                local pos=startP:Lerp(tgt,pct)
                if HRP then HRP.CFrame=CFrame.new(pos) end
                if pathPlt then pathPlt.CFrame=CFrame.new(pos.X,pos.Y-3.2,pos.Z) end
                RunService.Heartbeat:Wait()
            end
        end
        playing=false; bypassAntiTp=false
        if pathPlt then pathPlt:Destroy(); pathPlt=nil end
        for _,p in ipairs(trail) do pcall(function() p:Destroy() end) end
        trail={}
    end)
end

