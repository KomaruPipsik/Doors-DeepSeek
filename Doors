local PlayerService = {}

function PlayerService.SetupAntiRubberband()
    -- Кастомная реализация WalkSpeed без изменения свойства Humanoid.WalkSpeed 
    -- для обхода серверных проверок. Мы интерполируем CFrame персонажа на клиенте.
    RunService.Heartbeat:Connect(function(deltaTime)
        local character = LocalPlayer.Character
        if not character then return end
        
        local humanoid = character:FindFirstChild("Humanoid")
        local rootPart = character:FindFirstChild("HumanoidRootPart")
        
        if humanoid and rootPart and humanoid.Health > 0 then
            -- Если игрок двигается
            if humanoid.MoveDirection.Magnitude > 0 then
                -- Вычисляем разницу между стандартной скоростью и желаемой
                local speedDiff = Config.CustomWalkSpeed - humanoid.WalkSpeed
                if speedDiff > 0 then
                    -- Рассчитываем дополнительное смещение
                    local moveOffset = humanoid.MoveDirection * (speedDiff * deltaTime)
                    -- Безопасное изменение CFrame с учетом физики
                    rootPart.CFrame = rootPart.CFrame + moveOffset
                end
            end
        end
    end)
end

function PlayerService.SetupFullBright()
    if not Config.EnableFullBright then return end
    
    local function applyBright()
        Lighting.Ambient = Color3.new(1, 1, 1)
        Lighting.ColorShift_Bottom = Color3.new(1, 1, 1)
        Lighting.ColorShift_Top = Color3.new(1, 1, 1)
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 100000
    end

    applyBright()
    Lighting:GetPropertyChangedSignal("Ambient"):Connect(applyBright)
    Lighting:GetPropertyChangedSignal("FogEnd"):Connect(applyBright)
    Lighting:GetPropertyChangedSignal("GlobalShadows"):Connect(applyBright)
end

function PlayerService.SetupFPSBooster()
    if not Config.EnableFPSBooster then return end

    local function optimizeInstance(instance)
        pcall(function()
            if instance:IsA("BasePart") and not instance:IsA("MeshPart") then
                instance.Material = Enum.Material.SmoothPlastic
                instance.Reflectance = 0
                instance.CastShadow = false
            elseif instance:IsA("Decal") or instance:IsA("Texture") then
                -- Прячем текстуры и декали (прозрачность, чтобы не ломать логику игры, если она их ищет)
                instance.Transparency = 1 
            elseif instance:IsA("ParticleEmitter") or instance:IsA("Trail") then
                instance.Enabled = false
            end
        end)
    end

    -- Оптимизируем существующие объекты
    for _, desc in ipairs(Workspace:GetDescendants()) do
        optimizeInstance(desc)
    end

    -- Слушаем новые объекты
    Workspace.DescendantAdded:Connect(optimizeInstance)
    Utils.Notify("FPS Booster", "Материалы упрощены, тени отключены.")
end

function PlayerService.Initialize()
    PlayerService.SetupAntiRubberband()
    PlayerService.SetupFullBright()
    PlayerService.SetupFPSBooster()
end

