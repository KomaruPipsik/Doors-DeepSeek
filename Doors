--  SAFE PLATFORM — плита под игроком
-- ══════════════════════════════════════════════
local function CreatePlatform()
    if safePlatform then return end
    local part = Instance.new("Part")
    part.Name  = "_SafePlatform"
    part.Size  = Vector3.new(8, 0.5, 8)
    part.Anchored = true
    part.CanCollide = true
    part.Transparency = 0.5
    part.BrickColor = BrickColor.new("Bright blue")
    part.Material = Enum.Material.SmoothPlastic
    part.Parent = Workspace
    safePlatform = part
end

local function RemovePlatform()
    if safePlatform then
        safePlatform:Destroy()
        safePlatform = nil
    end
end

local function UpdatePlatform()
    if safePlatform and HumanoidRootPart then
        local pos = HumanoidRootPart.Position
        safePlatform.CFrame = CFrame.new(pos.X, pos.Y - 3.5, pos.Z)
    end
end

