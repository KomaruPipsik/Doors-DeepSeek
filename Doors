-- 1. УТИЛИТЫ И БАЗОВЫЕ ФУНКЦИИ
-- ==========================================
local Utils = {}

function Utils.Notify(title, text)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = 4
        })
    end)
end

function Utils.CreateESP(instance, color, name)
    if not instance or not instance:IsA("Instance") then return end
    
    -- Проверка на дубликат
    for _, child in ipairs(HighlightContainer:GetChildren()) do
        if child:GetAttribute("Target") == instance:GetFullName() then return end
    end

    local highlight = Instance.new("Highlight")
    highlight.Adornee = instance
    highlight.FillColor = color
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Name = name or "ESP"
    highlight:SetAttribute("Target", instance:GetFullName())
    highlight.Parent = HighlightContainer
    
    -- Автоматическое удаление ESP, если объект уничтожен
    local conn
    conn = instance.AncestryChanged:Connect(function(_, parent)
        if not parent then
            highlight:Destroy()
            conn:Disconnect()
        end
    end)
end

function Utils.FindAnyChild(parent, namesTable)
    if not parent then return nil end
    for _, name in ipairs(namesTable) do
        local child = parent:FindFirstChild(name)
        if child then return child end
    end
    return nil
end

