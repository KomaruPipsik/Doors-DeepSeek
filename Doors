-- Прячет/показывает ESP объектов в зависимости от расстояния
local function UpdateRadiusESP()
    if not F.radiusESP or not HRP then return end
    if not currentRooms then return end
    for _,room in ipairs(currentRooms:GetChildren()) do
        for _,desc in ipairs(room:GetDescendants()) do
            if not desc:IsA("BasePart") then continue end
            local dist=(desc.Position-HRP.Position).Magnitude
            -- Ищем все BillboardGui (надписи) и Highlight (обводки)
            for _,ch in ipairs(desc:GetChildren()) do
                if ch:IsA("BillboardGui") and ch.Name~="PlayerESP" then
                    ch.Enabled=(dist<=F.radiusVal)
                end
            end
            -- Highlight на родителе
            local par=desc.Parent
            if par and par~=room then
                for _,ch in ipairs(par:GetChildren()) do
                    if ch:IsA("Highlight") and ch.Name~="PlayerESP_HL" and ch.Name~="_XHL" then
                        ch.Enabled=(dist<=F.radiusVal)
                    end
                end
            end
        end
    end
end

