--  MAIN LOOP
-- ══════════════════════════════════════════════
local lastPos   = Vector3.new()
local scanTick  = 0

RunService.Heartbeat:Connect(function(dt)
    -- Скорость
    if speedEnabled and Humanoid then Humanoid.WalkSpeed = customSpeed end
    -- FOV
    Camera.FieldOfView = customFOV
    -- Анти-телепорт
    if antiTpEnabled and HumanoidRootPart then
        if (HumanoidRootPart.Position - lastPos).Magnitude > 50
            and not Workspace:GetAttribute("InElevator") then
            HumanoidRootPart.CFrame = CFrame.new(lastPos)
        else
            lastPos = HumanoidRootPart.Position
        end
    elseif HumanoidRootPart then
        lastPos = HumanoidRootPart.Position
    end

    -- Монстры (раз в 0.1 сек)
    scanTick = scanTick + dt
    if scanTick < 0.1 then return end
    scanTick = 0

    local ws = Workspace:GetChildren()
    local rushFound   = false
    local ambushFound = false

    for _, obj in ipairs(ws) do
        local isRush   = obj.Name == "RushMoving"
        local isAmbush = obj.Name == "AmbushMoving"

        if isRush or isAmbush then
            if rushNotif and not notifiedRush[obj] then
                notifiedRush[obj] = true
                SendNotif("⚠ ВНИМАНИЕ!", (isRush and "РАШ" or "АМБУШ").." летит!")
            end
            if rushAmbushESP then
                local part = GetPrimaryPart(obj)
                if part then MakeESP(part,"RushAmbushESP",isRush and "💨 РАШ" or "🌀 АМБУШ",Color3.fromRGB(255,60,60)) end
            end

            if isRush then
                rushFound = true
                -- Плавно вверх (один раз при появлении)
                if rushUpEnabled and HumanoidRootPart and not rushActive then
                    rushActive  = true
                    rushSavedY  = HumanoidRootPart.Position.Y
                    local fromY = rushSavedY
                    local toY   = rushSavedY + OFFSET_Y
                    CreatePlatform()
                    rushMoveConn = SmoothY(fromY, toY, MOVE_DUR, function(y)
                        if HumanoidRootPart then
                            local p = HumanoidRootPart.Position
                            HumanoidRootPart.CFrame = CFrame.new(p.X, y, p.Z)
                        end
                        UpdatePlatform()
                    end)
                end
            end

            if isAmbush then
                ambushFound = true
                if ambushDownEnabled and HumanoidRootPart and not ambushActive then
                    ambushActive = true
                    ambushSavedY = HumanoidRootPart.Position.Y
                    local fromY  = ambushSavedY
                    local toY    = ambushSavedY - OFFSET_Y
                    CreatePlatform()
                    ambushMoveConn = SmoothY(fromY, toY, MOVE_DUR, function(y)
                        if HumanoidRootPart then
                            local p = HumanoidRootPart.Position
                            HumanoidRootPart.CFrame = CFrame.new(p.X, y, p.Z)
                        end
                        UpdatePlatform()
                    end)
                end
            end
        end

        -- Eyes — отворачиваем камеру
        if obj.Name == "Eyes" then
            if eyesESP then
                local part = GetPrimaryPart(obj)
                if part then MakeESP(part,"EyesESP","👁 EYES",Color3.fromRGB(180,0,255)) end
            end
            if eyesAntiDmg and HumanoidRootPart then
                local part = GetPrimaryPart(obj)
                if part then
                    -- Блокируем взгляд на Eyes: смотрим от них
                    local away = (HumanoidRootPart.Position - part.Position).Unit
                    local newLook = Camera.CFrame.Position + away
                    Camera.CFrame = CFrame.new(Camera.CFrame.Position, newLook)
                end
            end
        end
    end

    -- Возврат после Rush — плавно
    if not rushFound and rushActive then
        rushActive = false
        if rushUpEnabled and HumanoidRootPart and rushSavedY then
            local fromY = HumanoidRootPart.Position.Y
            local toY   = rushSavedY
            SmoothY(fromY, toY, MOVE_DUR, function(y)
                if HumanoidRootPart then
                    local p = HumanoidRootPart.Position
                    HumanoidRootPart.CFrame = CFrame.new(p.X, y, p.Z)
                end
                UpdatePlatform()
            end, function()
                RemovePlatform()
                rushSavedY = nil
            end)
        end
    end

    -- Возврат после Ambush — плавно
    if not ambushFound and ambushActive then
        ambushActive = false
        if ambushDownEnabled and HumanoidRootPart and ambushSavedY then
            local fromY = HumanoidRootPart.Position.Y
            local toY   = ambushSavedY
            SmoothY(fromY, toY, MOVE_DUR, function(y)
                if HumanoidRootPart then
                    local p = HumanoidRootPart.Position
                    HumanoidRootPart.CFrame = CFrame.new(p.X, y, p.Z)
                end
                UpdatePlatform()
            end, function()
                RemovePlatform()
                ambushSavedY = nil
            end)
        end
    end

    -- Screech авто-поворот
    if screechTurn and activeSreech then
        local part = activeSreech:FindFirstChild("HumanoidRootPart") or activeSreech:FindFirstChildWhichIsA("BasePart")
        if part then Camera.CFrame = CFrame.new(Camera.CFrame.Position, part.Position) end
    end

    -- Figure
    if currentRooms then
        for _, room in ipairs(currentRooms:GetChildren()) do
            local rig = room:FindFirstChild("FigureRig",true) or room:FindFirstChild("FigureSetup",true)
            if rig then
                local pp = rig:FindFirstChild("HumanoidRootPart") or rig:FindFirstChildWhichIsA("BasePart")
                if pp then
                    if figureESP then MakeESP(pp,"FigureESP","👹 FIGURE",Color3.fromRGB(255,0,0)) end
                    -- Авто-отход: двигаем HRP напрямую (Humanoid:Move ненадёжен)
                    if figureAvoid and HumanoidRootPart then
                        local dist = (HumanoidRootPart.Position - pp.Position).Magnitude
                        if dist < avoidRadius then
                            local dir = (HumanoidRootPart.Position - pp.Position).Unit
                            -- Толкаем игрока в противоположную сторону
                            HumanoidRootPart.CFrame = HumanoidRootPart.CFrame + dir * 2
                        end
                    end
                end
            end
        end
    end

    -- Игроки ESP
    if playerESPEnabled then
        for _, plr in ipairs(Players:GetPlayers()) do
            SetPlayerESP(plr, true)
        end
    end
end)

