-- 2. СЕРВИС МЕНЕДЖМЕНТА КОМНАТ И ПРЕДМЕТОВ
-- ==========================================
local RoomService = {}

function RoomService.ScanRoom(room)
    if not room or not room:IsA("Model") then return end

    local assets = room:FindFirstChild("Assets")
    if not assets then return end

    -- 2.1. Поиск ложных дверей (DupeDoor)
    for _, door in ipairs(room:GetChildren()) do
        if door.Name == "Door" or door.Name == "Light" then
            local dupe = door:FindFirstChild("door") or door:FindFirstChild("DupeDoor")
            if dupe and door:GetAttribute("Hidden") == true then
                Utils.CreateESP(door, Config.ESP.DupeDoorColor, "DupeDoor")
            end
        end
    end

    -- 2.2. Поиск Ключей
    local dresser = assets:FindFirstChild("Dresser")
    if dresser then
        for _, desc in ipairs(dresser:GetDescendants()) do
            if desc.Name == "KeyObtain" or desc.Name == "KeyObtaln" then
                local hitbox = Utils.FindAnyChild(desc, {"Hitbox", "Hltbox"})
                if hitbox then
                    local keyPart = Utils.FindAnyChild(hitbox, {"KeyHitbox", "KeyNitbox"})
                    if keyPart then Utils.CreateESP(keyPart, Config.ESP.KeyColor, "Key") end
                end
            end
        end
    end

    -- 2.3. Поиск Капканов (Комнаты 90-99)
    local snare = assets:FindFirstChild("Snare")
    if snare then
        for _, desc in ipairs(snare:GetDescendants()) do
            if desc.Name == "SnareBase" and desc:IsA("BasePart") then
                Utils.CreateESP(desc, Config.ESP.SnareColor, "Snare")
            end
        end
    end

    -- 2.4. Поиск Рубильников (Комната 100)
    for _, desc in ipairs(room:GetDescendants()) do
        if desc.Name == "LiveBreakerPolePickup" or desc.Name == "LiveBreakerPolePlckup" then
            Utils.CreateESP(desc, Config.ESP.BreakerColor, "Breaker")
        end
    end

    -- 2.5. Комната 50: Книги-подсказки
    local bookshelves = Utils.FindAnyChild(assets, {"Bookshelves", "Bookshelvesl"})
    if bookshelves then
        for _, desc in ipairs(bookshelves:GetDescendants()) do
            if desc.Name == "LiveHintBook" then
                Utils.CreateESP(desc, Config.ESP.BookColor, "Book")
            end
        end
    end

    -- 2.6. Комната 50: Фигура
    local figureSetup = Utils.FindAnyChild(room, {"FigureSetup", "FlgureSetup"})
    if figureSetup then
        local figureRig = figureSetup:FindFirstChild("FigureRig")
        if figureRig then
            Utils.CreateESP(figureRig, Config.ESP.FigureColor, "Figure")
            RoomService.TrackFigure(figureRig)
        end
    end
end

function RoomService.TrackFigure(figure)
    RunService.Heartbeat:Connect(function()
        if figure and figure.Parent and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local root = LocalPlayer.Character.HumanoidRootPart
            local figureRoot = figure:FindFirstChild("HumanoidRootPart")
            if figureRoot then
                local dist = (root.Position - figureRoot.Position).Magnitude
                if dist <= Config.FigureSafeRadius then
                    -- Мягкое уведомление/логика избежания (пока только визуальный контроль расстояния)
                    -- Чтобы не спамить в чат, оставляем проверку тихой, но ESP работает
                end
            end
        end
    end)
end

function RoomService.Initialize()
    local currentRooms = Workspace:WaitForChild("CurrentRooms", 10)
    if currentRooms then
        -- Сканирование уже существующих комнат
        for _, room in ipairs(currentRooms:GetChildren()) do
            task.spawn(RoomService.ScanRoom, room)
        end
        -- Прослушивание новых
        currentRooms.ChildAdded:Connect(function(room)
            task.wait(0.5) -- Ждем генерацию ассетов
            task.spawn(RoomService.ScanRoom, room)
        end)
    end
end

